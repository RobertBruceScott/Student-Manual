       RowBox[{
        RowBox[{"lf", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", "x", "}"}]}], "]"}], " ", "//", " ", "Simplify"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"which", " ", "we", " ", "evaluate", " ", "with", " ", "x"}], 
     " ", "=", " ", 
