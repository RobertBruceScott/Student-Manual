      "Simplify"}]}], ";"}], "\n", 
   RowBox[{"d3", " ", "/.", " ", 
    RowBox[{"v", " ", "->", " ", "v"}]}], "\n", 
   RowBox[{"term3", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d3", " ", "/.", " ", 
       RowBox[{"v", " ", "->", " ", "0"}]}], ")"}], "/", 
