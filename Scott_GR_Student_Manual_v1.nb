Cell[CellGroupData[{

Cell["Exercise 13.6", "Section",
 CellChangeTimes->{{3.9634436297026787`*^9, 
  3.963443634913487*^9}},ExpressionUUID->"4bbae64a-2876-4f74-85c8-\
919e7d1ec4dc"],

Cell[CellGroupData[{

Cell[TextData[{
 "Prove the statement leading to \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["r", "TI"]}]], "\[LongEqual]", "-", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["r", "TI"], "2"]], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"2", "\[CapitalLambda]"}]], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-2", "\[CapitalLambda]"}]]}], ")"}], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "G_{rr} = - \\frac{1}{r^2} e^{2 \\Lambda} (1 - e^{-2 \\Lambda} ),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d14f630-e42d-48f6-be84-214b3a0d2928"],
 "   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], "\[Theta]\[Theta]"], "\[LongEqual]", "-", 
         StyleBox["r", "TI"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-2", "\[CapitalLambda]"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "G_{\\theta \\theta} = - r e^{- 2 \\Lambda} \\Lambda'", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2112956b-59b5-4be0-be57-a4e247316b47"],
 ", \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], "\[Phi]\[Phi]"], "\[LongEqual]", 
         SuperscriptBox["sin", "2"], "\[NegativeThinSpace]", "\[Theta] ", 
         SubscriptBox[
          StyleBox["G", "TI"], "\[Theta]\[Theta]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "G_{\\phi \\phi} &= \\sin^2\\!\\theta \\, G_{\\theta \\theta} ", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "352dbdf9-a79d-4181-927c-1daffc54a46a"],
 " \t\t\tSchutz Eq. (13.9)\n\nthat we can deduce ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["G", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "$G_{ij}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a9efd70-f14e-4b84-a36c-b2c849a023ef"],
 " of our three-spaces by setting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Phi=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea3187b3-ba16-45d8-b349-30c38c666a95"],
 " in the expression for the Einstein tensor (Schutz Eqs 10.15-17) for the \
spacetime with line element for a spherically symmetric star (Schutz Eq. \
(10.7))."
}], "Subsection",
 CellChangeTimes->{
  3.9634437111122723`*^9, {3.963443828500317*^9, 3.963443982389786*^9}, {
   3.963444242882195*^9, 
   3.963444355301811*^9}},ExpressionUUID->"e7c8589c-afb1-4fc3-bfaa-\
ed6575d5d34e"],

Cell["\<\


As an exercise in digging into the basics with Mathematica, below we use \
Mathematica\[CloseCurlyQuote]s core tools to calculate the Christoffel \
symbols important tensors of GR from the metric tensor. (Of course, there are \
more streamlined and powerful tools in Mathematica to compute these and much \
more. But below, we\[CloseCurlyQuote]ll see some great demonstrations of the \
power and simplicity of Mathematica.)\
\>", "Text",
 CellChangeTimes->{{3.963456801687572*^9, 3.963456854541647*^9}, {
   3.963456885295472*^9, 3.963456990935588*^9}, {3.963457094477284*^9, 
   3.9634570948269453`*^9}, 3.963502909494746*^9, {3.9635029424359083`*^9, 
   3.963503076182807*^9}},ExpressionUUID->"ad6d5f8a-6575-4541-9657-\
68e6b64c325c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Setting", " ", "up", " ", "the", " ", "Metric", " ", "in", " ",
     "Mathematica"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"First", ",", " ", 
    RowBox[{
    "we", " ", "clear", " ", "all", " ", "previous", " ", "definitions", " ", 
     "to", " ", "ensure", " ", "a", " ", "clean", " ", 
     RowBox[{"start", ".", " ", "Then"}]}], ",", " ", 
    RowBox[{
    "we", " ", "define", " ", "\n", "our", " ", "coordinates", " ", "and", " ",
      "the", " ", "3", "D", " ", "metric", " ", "tensor"}], ",", " ", 
    RowBox[{
     RowBox[{"g", ".", " ", "We"}], " ", "will", " ", "use", " ", "a", " ", 
     "general", " ", "function"}], ",", " ", 
    RowBox[{"\[Lambda]", "[", "r", "]"}], ",", " ", "\n", 
    RowBox[{"for", " ", "the", " ", "g_rr", " ", 
     RowBox[{"component", ".", " ", "This"}], " ", "corresponds", " ", "to", " ",
      "the", " ", "spatial", " ", "\n", "line", " ", "element", " ", "in", " ", 
     RowBox[{"Schutz", "'"}], "s", " ", 
     RowBox[{"Eq", ".", 
      RowBox[{"(", "13.8", ")"}]}], " ", 
     RowBox[{"above", ":"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dl", "^", "2"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}], "]"}], " ", 
      RowBox[{"dr", "^", "2"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"r", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d\[Theta]", "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], " ", 
         RowBox[{"d\[Phi]", "^", "2"}]}]}], ")"}]}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "coordinates", " ", "for", " ", "our", " ", 
     "3", "D", " ", "space"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}]}], ";"}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "metric", " ", "tensor", " ", "g_ij", " ", 
     "as", " ", "a", " ", "3", "x3", " ", "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"2", "*", 
           RowBox[{"\[Lambda]", "[", "r", "]"}]}], "]"}], ",", " ", "0", ",", 
         " ", "0"}], "}"}], ",", " ", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"r", "^", "2"}], ",", " ", "0"}], "}"}], ",", " ", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"r", "^", "2"}], " ", "*", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}]}], 
      "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"MatrixForm", "[", "g", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.963444577576111*^9, 3.963444582219923*^9}, {
