Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Initial", " ", "Conditions", " ", "from", " ", "Series", " ", 
    "Expansions"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "T"}], "-", "O", "-", 
      RowBox[{
      "V", " ", "equations", " ", "are", " ", "singular", " ", "at", " ", 
       "r"}]}], "=", 
     RowBox[{
      RowBox[{
      "0.", " ", "To", " ", "start", " ", "our", " ", "numerical", " ", 
       "integration", " ", "at", " ", "a", " ", "\n", "small", " ", "radius", 
       " ", "r"}], " ", ">", " ", "0"}]}], ",", " ", 
    RowBox[{
    "we", " ", "need", " ", "initial", " ", "values", " ", "for", " ", "mass",
      " ", "m", 
     RowBox[{"(", "r", ")"}], " ", "and", " ", "pressure", " ", "p", 
     RowBox[{
      RowBox[{"(", "r", ")"}], ".", " ", "These"}], " ", "\n", "are", " ", 
     "derived", " ", "from", " ", "a", " ", "power", " ", "series", " ", 
     "expansion", " ", "near", " ", "the", " ", "origin"}], ",", " ", 
    RowBox[{"as", " ", "described", " ", "in", " ", "Schutz"}], ",", " ", 
    "\n", 
    RowBox[{"Exercise", " ", 
     RowBox[{"10.15", "."}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "create", " ", "a", " ", "function", " ", 
    "`getInitialConditions`", " ", "that", " ", "takes", " ", "a", " ", 
    "central", " ", "density", " ", "`rhoc`", " ", "\n", "and", " ", 
    "calculates", " ", "the", " ", "appropriate", " ", "starting", " ", 
    "values", " ", "at", " ", "a", " ", "small", " ", "radius", " ", 
    RowBox[{"`rmax`", "."}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"maxRelativeErrorAcceptable", " ", "=", " ", "0.001"}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Code", "::"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"speedofsound", "[", "rho_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"adiabaticIndex", "[", "rho", "]"}], "*", 
       RowBox[{
        RowBox[{"press", "[", "rho", "]"}], "/", "rho"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"getPowerSeriesCoeffs", "[", "rhoc_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "pc", ",", " ", "p2", ",", " ", "rho2", ",", " ", "m3", ",", "m5", ",",
         "  ", "m", ",", " ", "rho"}], "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Central", " ", "pressure", " ", "from", " ", "EOS"}], " ", 
       "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"pc", " ", "=", " ", 
        RowBox[{"press", "[", "rhoc", "]"}]}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Second", " ", "derivative", " ", "of", " ", "pressure", " ", "at", " ",
          "the", " ", "center", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"from", " ", "Scott"}], ",", " ", 
           RowBox[{"eqn", ".", " ", "10.43"}]}], ")"}]}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"p2", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"2", "/", "3"}], ")"}]}], "*", "Pi", "*", 
          RowBox[{"(", 
           RowBox[{"rhoc", " ", "+", " ", "pc"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"rhoc", " ", "+", " ", 
            RowBox[{"3", "*", "pc"}]}], ")"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Second", " ", "derivative", " ", "of", " ", "density", " ", "at", " ",
          "the", " ", "center", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"from", " ", "Scott"}], ",", " ", 
           RowBox[{"eqn", ".", " ", "10.43"}]}], ")"}]}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"rho2", " ", "=", " ", 
        RowBox[{"p2", "*", 
         RowBox[{"rhoc", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"adiabaticIndex", "[", "rhoc", "]"}], "*", "pc"}], 
           ")"}]}]}]}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Calculate", " ", "m", 
         RowBox[{"(", "r", ")"}], " ", "and", " ", "rho", 
         RowBox[{"(", "r", ")"}], " ", "at", " ", "this", " ", "small", " ", 
         "radius", " ", "using", " ", "the", " ", "series"}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"See", " ", "Scott", " ", "eqn", 
          RowBox[{"(", "10.42", ")"}], " ", "in", " ", "the", " ", "solution",
           " ", "to", " ", 
          RowBox[{"Exer", ".", " ", "10.15"}]}], ":"}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"m3", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "/", "3"}], ")"}], "*", "Pi", "*", "rhoc"}]}], ";", 
       "\n", "  ", 
       RowBox[{"m5", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "/", "5"}], ")"}], "*", "Pi", "*", "rho2"}]}], ";", 
       "\n", "  ", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{
         RowBox[{"m3", "*", 
          RowBox[{"r", "^", "3"}]}], " ", "+", " ", 
         RowBox[{"m5", "*", 
          RowBox[{"r", "^", "5"}]}]}]}], ";", "\n", "  ", 
       RowBox[{"rho", " ", "=", " ", 
        RowBox[{"rhoc", " ", "+", " ", 
         RowBox[{"rho2", "*", 
          RowBox[{"r", "^", "2"}]}]}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Return", " ", "the", " ", "list", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"starting", " ", "radius"}], ",", " ", "mass", ",", " ", 
           "pressure"}], "}"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"{", 
        RowBox[{
        "pc", ",", " ", "p2", ",", " ", "rho2", ",", " ", "m3", ",", " ", 
         "m5"}], "}"}]}]}], "\n", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"getICr", "[", "rhoc_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "coeffs", ",", "pc", ",", " ", "p2", ",", " ", "rho2", ",", " ", "m3", 
        ",", "m5", ",", "rmaxmass", ",", "rmaxpress", ",", " ", "rmaxrho", ",",
         " ", "r", ",", " ", "m", ",", " ", "rho", ",", " ", "p"}], "}"}], ",",
       "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Central", " ", "pressure", " ", "from", " ", "EOS"}], " ", 
       "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"coeffs", " ", "=", " ", 
        RowBox[{"getPowerSeriesCoeffs", "[", "rhoc", "]"}]}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Second", " ", "derivative", " ", "of", " ", "pressure", " ", "at", " ",
          "the", " ", "center", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"from", " ", "Scott"}], ",", " ", 
           RowBox[{"eqn", ".", " ", "10.43"}]}], ")"}]}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"pc", " ", "=", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"p2", " ", "=", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"rho2", " ", "=", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"m3", " ", "=", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"m5", " ", "=", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Estimate", " ", "a", " ", "small", " ", 
         RowBox[{"radius", " ", "'"}], 
         RowBox[{"rmax", "'"}], " ", "where", " ", "the", " ", "series", " ", 
         "is", " ", "still", " ", "accurate"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"rmaxmass", " ", "=", "  ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "maxRelativeErrorAcceptable", "]"}], "*", 
           RowBox[{"m3", "/", "m5"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"rmaxpress", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "maxRelativeErrorAcceptable", "]"}], "*", 
           RowBox[{"pc", "/", "p2"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"rmaxrho", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "maxRelativeErrorAcceptable", "]"}], "*", 
           RowBox[{"rhoc", "/", "rho2"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"rmaxpress", ",", " ", "rmaxrho", ",", "rmaxmass"}], "]"}]}],
        ";", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rmaxmass", ",", "rmaxpress", ",", "rmaxrho"}], 
