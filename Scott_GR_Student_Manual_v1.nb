    "e2a2eb4d-cf90-486d-8938-22817860e8a9"], TraditionalForm]],ExpressionUUID->
  "f1848beb-d0b4-42a2-9d19-0030306cd1b0"],
 "\nis only flat at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$r=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e68c7e1b-2b52-4323-9692-dbb429cd14dd"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$A=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b84cf88-27d9-4ade-9aa1-6bd280944af1"],
 " in \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  SubscriptBox[
                   StyleBox["g", "TI"], 
                   RowBox[{
                    StyleBox["r", "TI"], 
                    StyleBox["r", "TI"]}]]], "InlineFormula"], " "}], 
              CellTags -> "SchutzEq.13.11"], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"2", "\[CapitalLambda]"}]], "\[LongEqual]", 
                    FractionBox["1", 
                    RowBox[{"1", "+", 
                    FractionBox["1", "3"], "\[Kappa]", 
                    SuperscriptBox[
                    StyleBox["r", "TI"], "2"], "-", 
                    FractionBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]]}]], "."}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["Schutz Eq.\[NonBreakingSpace](13.12)", "InlineFormula"],
                 " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{align}\\label{SchutzEq.13.11}\ng_{rr} &= e^{2 \\Lambda} = \
\\frac{1}{1 + \\frac{1}{3} \\kappa r^2 - \\frac{A}{r} }. & \\mbox{Schutz \
Eq.~(13.12)}\n\\end{align}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cafe7a95-504c-4f8e-9469-ba39999de05a"]
}], "Subsection",
 CellChangeTimes->{{3.963362773080645*^9, 3.963362775881567*^9}, 
