Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "3.", " ", "Numerical", " ", "Integration", " ", "of", " ", "the", " ", 
     "T"}], "-", "O", "-", 
    RowBox[{"V", " ", "Equations"}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Now", " ", "we", " ", "solve", " ", "the", " ", "coupled", " ", 
    "differential", " ", "equations", " ", "for", " ", "stellar", " ", 
    RowBox[{"structure", ":", " ", 
     RowBox[{
      RowBox[{"the", " ", "\n", "mass"}], "-", 
      RowBox[{
      "continuity", " ", "equation", " ", "and", " ", "the", " ", "Tolman"}], 
      "-", "Oppenheimer", "-", 
      RowBox[{"Volkoff", " ", 
       RowBox[{"(", 
        RowBox[{"T", "-", "O", "-", "V"}], ")"}], " ", "equation", " ", "\n", 
       "for", " ", "hydrostatic", " ", 
       RowBox[{"equilibrium", "."}]}]}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Defining", " ", "the", " ", "Differential", " ", "Equations"}], 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "system", " ", "of", " ", "equations", " ", "is", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"from", " ", "Schutz"}], ",", " ", 
       RowBox[{"Chapter", " ", "10"}]}], ")"}]}], ":"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dm", "/", "dr"}], " ", "=", " ", 
    RowBox[{"4", 
     RowBox[{"\[Pi]r", "^", "2"}], " ", "\[Rho]", 
     RowBox[{"(", "p", ")"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dp", "/", "dr"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Rho]", 
         RowBox[{"(", "p", ")"}]}], " ", "+", " ", "p"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", " ", "+", " ", 
        RowBox[{"4", 
         RowBox[{"\[Pi]r", "^", "3"}], " ", "p"}]}], ")"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", "m"}]}], ")"}]}], ")"}]}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "differential", " ", 
    RowBox[{"equations", ".", " ", "Note"}], " ", "that", " ", "rho", " ", 
    "is", " ", "a", " ", "function", " ", "of", " ", 
    RowBox[{"p", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"eqns", " ", "=", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"m", "'"}], "[", "r", "]"}], " ", "==", " ", 
       RowBox[{"4", "*", "Pi", "*", 
        RowBox[{"r", "^", "2"}], "*", 
        RowBox[{"rhoofp", "[", 
         RowBox[{"p", "[", "r", "]"}], "]"}]}]}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "'"}], "[", "r", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rhoofp", "[", 
            RowBox[{"p", "[", "r", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"p", "[", "r", "]"}]}], ")"}]}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", "r", "]"}], " ", "+", " ", 
           RowBox[{"4", "*", "Pi", "*", 
            RowBox[{"r", "^", "3"}], "*", 
            RowBox[{"p", "[", "r", "]"}]}]}], ")"}], " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"r", "*", 
           RowBox[{"(", 
            RowBox[{"r", " ", "-", " ", 
             RowBox[{"2", "*", 
              RowBox[{"m", "[", "r", "]"}]}]}], ")"}]}], ")"}]}]}]}]}], "\n", 
     "   ", "}"}]}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solving", " ", "for", " ", "Different", " ", "Central", " ", 
     "Densities"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n Solving ODE from ICs from the power series with a \
max relative error:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"Print", "[", "maxRelativeErrorAcceptable", "]"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "We", " ", "will", " ", "now", " ", "solve", " ", "the", " ", "system", " ",
       "for", " ", "each", " ", "of", " ", "the", " ", "central", " ", 
      "densities", " ", "requested", " ", "in", " ", "\n", "the", " ", 
      RowBox[{"exercise", ".", " ", "For"}], " ", "each", " ", "case"}], ",", 
     " ", 
     RowBox[{
     "we", " ", "first", " ", "get", " ", "the", " ", "initial", " ", 
      "conditions", " ", "at", " ", "a", " ", "small", " ", "\n", "radius", " ",
       "`r_start`"}], ",", " ", 
     RowBox[{
     "and", " ", "then", " ", "use", " ", "`NDSolve`", " ", "to", " ", 
      "integrate", " ", "outwards", " ", "until", " ", "the", " ", "\n", 
      "pressure", " ", "drops", " ", "to", " ", "zero"}], ",", " ", 
     RowBox[{"which", " ", "defines", " ", "the", " ", 
      RowBox[{"star", "'"}], "s", " ", 
      RowBox[{"surface", "."}]}]}], "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "List", " ", "of", " ", "central", " ", "densities", " ", "to", " ", 
     "model", " ", 
     RowBox[{"(", 
      RowBox[{"as", " ", "multiples", " ", "of", " ", "rhostar"}], ")"}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhocRatios", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.1", ",", " ", "0.8", ",", " ", "1.2", ",", " ", "2", ",", " ", "5", ",",
        " ", "10", ",", " ", "100", ",", "1000"}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"We", " ", "will", " ", "store", " ", "the", " ", "solutions", " ", 
     RowBox[{"(", 
      RowBox[{"InterpolatingFunction", " ", "objects"}], ")"}], " ", "in", " ",
      "a", " ", "list"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"solutions", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rStartAll", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Loop", " ", "through", " ", "each", " ", "central", " ", "density", " ", 
     "ratio"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
      RowBox[{"i", " ", "<=", " ", 
       RowBox[{"Length", "[", "rhocRatios", "]"}]}], ",", " ", 
      RowBox[{"i", "++"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"rhoc", " ", "=", " ", 
        RowBox[{
         RowBox[{"rhocRatios", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", "*", " ", "rhostar"}]}], ";", 
       "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\\n for rhoc = \>\"", ",", " ", "rhoc"}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Get", " ", "initial", " ", "conditions", " ", 
         RowBox[{"{", 
          RowBox[{"r_start", ",", " ", "m_start", ",", " ", "p_start"}], 
          "}"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"initialConditions", " ", "=", " ", 
        RowBox[{"getInitialConditions", "[", "rhoc", "]"}]}], ";", "\n", "  ", 
       RowBox[{"rStart", " ", "=", " ", 
        RowBox[{"initialConditions", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"mStart", " ", "=", " ", 
        RowBox[{"initialConditions", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"pStart", " ", "=", " ", 
        RowBox[{"initialConditions", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
       "Print", "[", "\"\<\\n found  these starting values \>\"", "]"}], ";", 
       "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<r start = \>\"", ",", " ", "rStart"}], "]"}], ";", "\n", 
       "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<m start = \>\"", ",", " ", "mStart"}], "]"}], ";", "\n", 
       "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<p start = \>\"", ",", " ", "pStart"}], "]"}], ";", " ", 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Numerically", " ", "solve", " ", "the", " ", "ODEs"}], " ", 
        "*)"}], "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "We", " ", "use", " ", "\"\<WhenEvent\>\"", " ", "to", " ", "stop", " ",
          "the", " ", "integration", " ", "when", " ", 
         RowBox[{"p", "[", "r", "]"}], " ", "hits", " ", "zero"}], " ", 
        "*)"}], "\n", "  ", 
       RowBox[{"sol", " ", "=", " ", 
        RowBox[{"NDSolveValue", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"eqns", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"eqns", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"m", "[", "rStart", "]"}], " ", "==", " ", "mStart"}], ",",
             " ", 
            RowBox[{
             RowBox[{"p", "[", "rStart", "]"}], " ", "==", " ", "pStart"}]}], 
           "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "p"}], "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "rStart", ",", " ", "rStop"}], "}"}]}], " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Integrate", " ", "out", " ", "to", " ", "a", " ", "large", " ", 
           "radius"}], " ", "*)"}], "\n", "    ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Method", " ", "->", " ", "\"\<StiffnessSwitching\>\""}], 
         ","}], " ", "*)"}], "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"\"\<WhenEvent\>\"", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "r", "]"}], " ", "<", " ", "1*^-20"}], ",", 
          " ", "\"\<StopIntegration\>\""}], "]"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"solutions", ",", " ", "sol"}], "]"}], ";", "\n", "  ", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"rStartAll", ",", " ", "rStart"}], "]"}], ";"}]}], "\n", 
     "    ", "]"}], ";"}]}]}]], "Code",
