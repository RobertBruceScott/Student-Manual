Cell[CellGroupData[{

Cell["Exercise 13.23", "Section",
 CellChangeTimes->{{3.963604448976809*^9, 
  3.963604454138734*^9}},ExpressionUUID->"e0c53bd8-987f-4e66-ae59-\
24e7f5d0b311"],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate the redshift of decoupling by assuming that the cosmic microwave \
radiation has temperature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["2.7", TraditionalForm], "errors" -> {}, "input" -> 
     "$2.7$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b498364b-a088-4d4d-8c1c-7fe918796600"],
 " K today and had the temperature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["i", "TI"]], "/", "20", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$E_i/20k_B$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79469ab6-79fc-440e-8c6c-411f75cd9ebc"],
 " at decoupling, where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "13.6"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$E_i = 13.6$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73e7d79d-75fa-4066-a8ab-7113d7e92da6"],
 "eV is the energy needed to ionize hydrogen, see Exer. 13.22(c), [and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]], "\[LongEqual]", "8.617", "\[Cross]", 
         SuperscriptBox["10", "-5"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$k_B = 8.617 \\times 10^{-5} $", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b1ab905-ca05-4274-8da6-b3370924dbe5"],
 "eV/K is the Boltzmann constant.]"
}], "Subsection",
 CellChangeTimes->{{3.963604514419764*^9, 3.963604573796301*^9}},
 TextJustification->1.,ExpressionUUID->"153d5689-75e5-45fc-b7d9-e51abfae0b13"],

Cell["\<\
The cosmic microwave radiation has been out of equilibrium with matter since \
the time of decoupling, and has cooled in proportion to the expansion of the \
universe, \
\>", "Text",
 CellChangeTimes->{{3.963604681392961*^9, 3.9636047518015738`*^9}, {
   3.963604827752941*^9, 3.963604893201357*^9}, 3.963604995691166*^9},
 TextJustification->1.,ExpressionUUID->"0a2d3f14-0735-4533-a1ed-76d051a69f1d"],

Cell[BoxData[
 RowBox[{"T", " ", "=", " ", 
  FormBox[
   FractionBox[
    RowBox[{"T0", " ", "R0"}], "R"],
   TraditionalForm]}]], "Input",
 CellChangeTimes->{{3.963606545627396*^9, 3.963606552176537*^9}, {
  3.963606586137012*^9, 
  3.963606638400836*^9}},ExpressionUUID->"a04eb9f1-d0b9-40eb-b1f6-\
84be3f748802"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$T_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b673589-10be-4c6f-be60-d0b076439dff"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$R_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3af516f-1d00-47a4-bbce-c0224f10fd76"],
 " are the radiation temperature and expansion factor today, see Exer.~13.15. "
}], "Text",
 CellChangeTimes->{{3.963604681392961*^9, 3.9636047518015738`*^9}, {
  3.963604827752941*^9, 3.963604893201357*^9}, {3.963605214705593*^9, 
  3.963605243143079*^9}, {3.963605289364181*^9, 3.963605317977396*^9}, {
  3.9636057883511353`*^9, 3.963605798242148*^9}, {3.963606276795451*^9, 
  3.9636062855307617`*^9}},
 TextJustification->1.,ExpressionUUID->"97f78c51-1ed3-47c4-86fa-49c737b5c06c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "by", " ", "entering", " ", "the", " ", "2.7", " ", "as", " ", "a", " ", 
     "Quantity", " ", "with", " ", "units", " ", "\"\<Kelvins\>\""}], ",", 
    " ", 
    RowBox[{
    "Mathematica", " ", "can", " ", "keep", " ", "\n", "track", " ", "of", " ",
      "the", " ", "units"}]}], " ", "*)"}], "\n", 
  RowBox[{"T0", " ", "=", " ", 
   RowBox[{"Quantity", "[", 
    RowBox[{"2.7", ",", "\"\<Kelvins\>\""}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.963606294216793*^9, 3.9636063131431503`*^9}, {
  3.963606706717329*^9, 
  3.963606736687366*^9}},ExpressionUUID->"2d84da5c-913b-404e-bf22-\
cadc6351828b"],

Cell[BoxData[
 TemplateBox[{"2.7`", "\"K\"", "kelvins", "\"Kelvins\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.963606319392096*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"10b366ae-bdfb-4ac1-9577-f38424dcb122"]
}, Open  ]],

Cell[TextData[{
 "Using the suggestion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["i", "TI"]], "/", "20", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$E_i/20k_B$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28a98828-1ad4-4f3a-bc65-33b437bd1c38"],
 " for the temperature at decoupling, we find a temperature at the time of \
decoupling\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["E", "TI"], 
                    StyleBox["i", "TI"]], "/", "20", 
                    SubscriptBox[
                    StyleBox["k", "TI"], 
                    StyleBox["B", "TI"]]}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "7891", " K", "."}]], 
                 "InlineFormula"], " "}]]}}], TraditionalForm]]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\begin{align}\nE_i/20k_B&=7891\\mbox{ K}.\n\\end{align}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f36353c-89bc-4dcf-a19f-905e36bec180"]
}], "Text",
 CellChangeTimes->{{3.963604681392961*^9, 3.9636047518015738`*^9}, {
  3.963604827752941*^9, 3.963604893201357*^9}, {3.963605214705593*^9, 
  3.963605243143079*^9}, {3.963605289364181*^9, 3.963605317977396*^9}, {
  3.9636057883511353`*^9, 3.963605798242148*^9}, {3.963606276795451*^9, 
  3.963606277750477*^9}},
 TextJustification->1.,ExpressionUUID->"d81b5879-61bf-42c9-b695-15408511fc8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "by", " ", "entering", " ", "the", " ", "13.6", " ", "as", " ", "a", " ", 
     "Quantity", " ", "with", " ", "units", " ", "\"\<eV\>\""}], ",", " ", 
    RowBox[{
    "Mathematica", " ", "telling", " ", "us", " ", "\n", "below", " ", "that",
      " ", "the", " ", "temperature", " ", "is", " ", "in", " ", "Kelvin"}]}],
    " ", "*)"}], "\n", 
  RowBox[{"T", " ", "=", " ", 
   RowBox[{
    RowBox[{"Quantity", "[", 
     RowBox[{"13.6", ",", "\"\<eV\>\""}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"20", "*", "kBeVperK"}], ")"}]}]}]}]], "Code",
 CellChangeTimes->{{3.963605806044559*^9, 3.963605837548913*^9}, {
  3.9636059838093443`*^9, 3.963606155873494*^9}, {3.9636067525869627`*^9, 
  3.9636067579542*^9}},ExpressionUUID->"461c880c-19e4-46a1-bd95-656b1222024c"],

Cell[BoxData[
 TemplateBox[{"7891.073465750306`", "\"K\"", "kelvins", "\"Kelvins\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.963606031166128*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"d7f16ff7-e4ab-4f65-86aa-e0c30e97edac"]
}, Open  ]],

Cell[TextData[{
 "Why the factor of 20? Schutz discusses this in his Exer.~13.22(c), where he \
gives a more precise value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"26.7", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$26.7 k_B$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "809cfd6b-39dc-4b0c-8b3d-46d2996220f4"],
 ", which implies a decoupling temperature of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"5911", " K"}], TraditionalForm], "errors" -> {}, "input" -> 
     "$5911\\mbox{ K}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b98f80e-89fe-4e29-a202-5769a50d9f00"],
 ".\nUsing the redshift formula, (Scott eqn. (13.26), Schutz 13.67))\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"1", "+", 
                    StyleBox["z", "TI"], 
                    RowBox[{"(", 
                    StyleBox["t", "TI"], ")"}]}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    FractionBox[
                    SubscriptBox[
                    StyleBox["R", "TI"], "0"], 
                    RowBox[{
                    StyleBox["R", "TI"], "(", 
                    StyleBox["t", "TI"], ")"}]]}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{align}\n1 + z(t) &= \\frac{R_0}{R(t)} \n\\end{align}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdaebc54-8330-47a9-9f1b-9ed44c863e06"],
 "\nSubstituting the temperatures for the scale factors using the first \
equation above we find:"
}], "Text",
 CellChangeTimes->{{3.963604681392961*^9, 3.9636047518015738`*^9}, {
   3.963604827752941*^9, 3.963604893201357*^9}, {3.963605214705593*^9, 
   3.963605243143079*^9}, {3.963605289364181*^9, 3.963605317977396*^9}, 
   3.9636057883511353`*^9, {3.96360681056988*^9, 3.963606887171417*^9}},
 TextJustification->1.,ExpressionUUID->"70d24baa-97d4-47fe-a998-1ed9d05cb442"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Redshift", " ", "z", " ", "at", " ", "the", " ", "time", " ", "of", " ", 
    RowBox[{"decoupling", ":"}]}], " ", "*)"}], " ", "\n", 
  RowBox[{"z", " ", "=", " ", 
   RowBox[{
    RowBox[{"T", "/", "T0"}], " ", "-", " ", "1"}]}]}]], "Code",
 CellChangeTimes->{{3.9636054480774717`*^9, 3.9636054502364397`*^9}, {
  3.9636054986952543`*^9, 3.963605507261279*^9}, {3.96360574559451*^9, 
  3.963605766644738*^9}, {3.963606165349669*^9, 3.963606168637137*^9}, {
  3.963606332337613*^9, 3.963606333876637*^9}, {3.963606364205917*^9, 
  3.9636064225464993`*^9}},ExpressionUUID->"50d26153-00dc-468d-adf8-\
6c7fb95907a0"],

Cell[BoxData["2921.6198021297428`"], "Output",
 CellChangeTimes->{3.9636055123021584`*^9, 3.96360634811517*^9},
 CellLabel->
  "Out[152]=",ExpressionUUID->"11f1e731-8295-4ef0-a8da-4d7e4845fb49"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercise 13.25", "Section",
 CellChangeTimes->{{3.96360810886862*^9, 
  3.963608115096809*^9}},ExpressionUUID->"2ed96828-df7f-4703-8279-\
ae8959b42ea9"],

Cell[CellGroupData[{

Cell["\<\
Estimate the times earlier than which our uncertainty about the laws of \
physics prevents us drawing firm conclusions about cosmology as follows.\
\>", "Subsection",
 CellChangeTimes->{3.963608148822381*^9},
 TextJustification->1.,ExpressionUUID->"9dcfaf52-c91b-4447-ab83-faffe8aa4864"],

Cell[CellGroupData[{

Cell[TextData[{
 "(a) Deduce that, in the radiation-dominated early universe, where the \
curvature term depending on the curvature constant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "-1"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$k \\in \\{0, 1, -1\\}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cc38faf-7350-41c5-962d-be678b0f6dee"],
 " is negligible, the temperature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$T$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3e072c8-b671-4978-9b41-c56e5228eeff"],
 " behaves as\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  StyleBox["T", "TI"]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "\[Beta]", 
                    SuperscriptBox[
                    StyleBox["t", "TI"], 
                    RowBox[{"-1", "/", "2"}]], ","}]], "InlineFormula"], 
                " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"with ", "\[Beta]", "\[LongEqual]", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["45", "3"], "/", "32", 
                    SuperscriptBox["\[Pi]", "3"]}], ")"}], 
                    RowBox[{"1", "/", "4"}]], 
                    SubsuperscriptBox[
                    StyleBox["k", "TI"], 
                    StyleBox["B", "TI"], "-1"], ","}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{align}\nT &= \\beta t^{-1/2}, &\\mbox{with  } \\beta = (45 \
\\hbar^3/32\\pi^3)^{1/4} k_B^{-1},\n\\end{align}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b88b8851-c5f6-47c4-8e5a-81fd2bb61735"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["B", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$k_B$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b0a8473-9935-47cc-b245-e4fd0c7bc551"],
 " is Boltzmann\[CloseCurlyQuote]s constant."
}], "Subsubsection",
 CellChangeTimes->{{3.9636081675355883`*^9, 3.963608168970874*^9}, {
  3.9636082127441063`*^9, 
  3.9636082532206984`*^9}},ExpressionUUID->"d2bdb544-2eac-4253-9b3e-\
ef473854d8e3"],

Cell["See Scott eqn. (13.79)", "Text",
 CellChangeTimes->{{3.9636083267706337`*^9, 
  3.963608347152474*^9}},ExpressionUUID->"d4dd91d4-ef4e-4aee-b5ea-\
86a24a1de38e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "have", " ", "defined", " ", "precise", " ", "values", " ", 
    "of", " ", "the", " ", "standard", " ", "physical", " ", "constants", " ",
     "in", " ", "Chapter", "\n", "Fundamentals", " ", 
    RowBox[{"above", "."}]}], "  ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"beta", " ", "=", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"45", " ", "*", " ", 
        RowBox[{"hbarSI", "^", "3"}], " ", "*", " ", 
        RowBox[{
         RowBox[{"cSI", "^", "5"}], " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"32", " ", "*", " ", 
           RowBox[{"Pi", "^", "3"}], " ", "*", " ", "GSI", " ", "*", " ", 
           RowBox[{"kBSI", "^", "4"}]}], ")"}]}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Note", " ", "that", " ", "when", " ", "we", " ", "evaluate", " ", "beta",
      " ", "we", " ", "get", " ", "both", " ", "a", " ", "numerical", " ", 
     "value", " ", "and", " ", "its", " ", "units"}], " ", "*)"}], "\n", 
   RowBox[{"N", "[", 
    RowBox[{"beta", ",", "4"}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"However", ",", " ", 
     RowBox[{"the", " ", "units", " ", "seems", " ", 
      RowBox[{"complicated", ".", " ", "We"}], " ", "anticipated", " ", 
      RowBox[{"K", "/", "sqrt"}], 
      RowBox[{"(", "s", ")"}]}], ",", " ", 
     RowBox[{
      RowBox[{"let", "'"}], "s", " ", 
      RowBox[{"check", "!"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"beta", ",", 
     RowBox[{"\"\<Kelvins\>\"", "*", 
      RowBox[{"\"\<Seconds\>\"", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], "]"}], "\n", 
   RowBox[{"QuantityMagnitude", "[", "beta", "]"}]}]}]], "Code",
