   "The", " ", "final", " ", "frequency", " ", "in", " ", "kHz", " ", 
    RowBox[{"(", 
     RowBox[{"from", " ", "Schutz", " ", 
      RowBox[{"Eq", ".", " ", "12.2"}]}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ffinal", " ", "=", " ", 
     RowBox[{"4.0", " ", "/", " ", "mChirpValue"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"suppress", " ", "output", " ", "with", " ", "\"\<;\>\""}], " ", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"The", " ", "final", " ", "frequency", " ", "in", " ", "Hz"}], 
    " ", "*)"}], "\n", 
   RowBox[{"ffinalHz", " ", "=", " ", 
    RowBox[{"ffinal", " ", "*", " ", "1000", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"compare", " ", "to", " ", "Scott", " ", "eqn", 
       RowBox[{"(", "12.107", ")"}]}], " ", "*)"}]}]}]}]}]], "Code",
 CellChangeTimes->{
  3.963202621721108*^9, {3.9632026957949247`*^9, 3.9632027157082443`*^9}, {
   3.963202749928948*^9, 
   3.9632028362798233`*^9}},ExpressionUUID->"61b2e25f-9568-45bb-9081-\
deade1e616fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "corresponding", " ", "wavelength", " ", "in", " ", "meters"}],
    " ", "*)"}], "\n", 
  RowBox[{"lambdafinalSI", " ", "=", " ", 
   RowBox[{"cSI", " ", "/", " ", "ffinalHz", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"compare", " ", "to", " ", "Scott", " ", "eqn", 
      RowBox[{"(", "12.108", ")"}]}], " ", "*)"}]}]}]}]], "Code",
