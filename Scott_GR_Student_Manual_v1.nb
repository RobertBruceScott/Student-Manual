Cell["\<\
Only need to run this once for a given choice of mu (then can use even for \
different rhoc/rhostar):

All variables in geometric units

Defined below we have:
(1) a procedure for p depending on rho, with fixed parameter mu;
(2) a procedure for the adiabatic index
(3) a procedure for rho depending on p, with fixed parameter mu;

p = f(rho) in SI units.\
\>", "Text",
 CellChangeTimes->{
  3.965271617428363*^9, 3.9652716564149837`*^9, {3.965294494318294*^9, 
   3.965294495695991*^9}},ExpressionUUID->"0c37a602-5165-4a27-9ed7-\
5946a7464a12"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "the", " ", "pressure", " ", "as", " ", "a", " ", 
    "function", " ", "of", " ", "density", " ", 
    RowBox[{"(", 
     RowBox[{"Schutz", ",", " ", 
      RowBox[{"Eq", ".", " ", "10.93"}]}], ")"}], " ", "\n", "Scott", " ", 
    "eqn", 
    RowBox[{"(", "10.44", ")"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"This", " ", "is", " ", "a", " ", "piecewise", " ", 
    RowBox[{"function", ".", " ", "We"}], " ", "use", " ", 
    RowBox[{"Mathematica", "'"}], "s", " ", 
    RowBox[{"If", "[", "...", "]"}], " ", 
    RowBox[{"statement", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"press", "[", "rho_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"rhostar", " ", "<=", " ", "rho"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}], "*", "rho"}], ",", " ", 
       RowBox[{"kGU", "*", 
        RowBox[{"rho", "^", 
         RowBox[{"(", 
          RowBox[{"4", "/", "3"}], ")"}]}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "pressure", " ", "at", " ", "the", " ", "critical", " ", 
     "density"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pstar", " ", "=", " ", 
     RowBox[{"press", "[", "rhostar", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Define", " ", "the", " ", "density", " ", "as", " ", "a", " ", 
      "function", " ", "of", " ", "pressure", " ", 
      RowBox[{"(", 
       RowBox[{"the", " ", "inverse", " ", "EOS"}], ")"}], " ", "\n", "Note", 
      " ", "that", " ", "pressure", " ", "increases", " ", "monotonically", " ",
       "with", " ", "density", " ", "above"}], ",", " ", 
     RowBox[{
     "so", " ", "the", " ", "\n", "density", " ", "can", " ", "also", " ", 
      "be", " ", "defined", " ", "as", " ", "a", " ", "function", " ", "of", " ",
       "pressure", " ", "and", " ", "the", " ", "inequalities", " ", "are", "\n",
       "easily", " ", 
      RowBox[{"handled", ".", "\n", "Pressure"}], " ", "can", " ", "become", " ",
       "negative", " ", "due", " ", "to", " ", "numerical", " ", 
      RowBox[{"noise", ".", " ", "To"}], " ", "avoid", " ", "this"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"use", "\n", "the", " ", "Max", " ", 
       RowBox[{"function", ".", "\n", "June"}], " ", "2022"}], ":", " ", 
      RowBox[{"fixed", " ", "typo"}]}], ",", " ", 
     RowBox[{"by", " ", "changing", " ", "exponent", " ", "from", " ", 
      RowBox[{"(", 
       RowBox[{"4", "/", "3"}], ")"}], " ", "to", " ", 
      RowBox[{"(", 
       RowBox[{"3", "/", "4"}], ")"}], "\n", "Thanks", " ", "to", " ", 
      "Shafayat", " ", "Shawqi", " ", "of", " ", "University", " ", "of", " ", 
      RowBox[{"Alberta", "!"}]}]}], "\n", "\n", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoofpOld", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pstar", " ", "<=", " ", "p"}], ",", " ", 
       RowBox[{"3", "*", "p"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "/", "kGU"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "4"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoofp", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pstar", " ", "<=", " ", "p"}], ",", " ", 
       RowBox[{"3", "*", "p"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "p"}], "]"}], "/", "kGU"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "4"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "adiabatic", " ", "index", " ", "as", " ", "a",
      " ", "function", " ", "of", " ", "density"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"adiabaticIndex", "[", "rho_", "]"}], " ", ":=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"rhostar", " ", "<=", " ", "rho"}], ",", " ", 
      RowBox[{"1", "/", "3"}], ",", " ", 
      RowBox[{"4", "/", "3"}]}], "]"}]}]}]}]], "Code",
 CellChangeTimes->{
  3.965263348237855*^9, {3.965263395094975*^9, 3.965263473421803*^9}, {
   3.965263516437557*^9, 3.9652635299549828`*^9}, {3.965263757480715*^9, 
   3.965263982666394*^9}, 3.965264137993381*^9, 3.965269541566886*^9, 
   3.96526957216765*^9, {3.965269607240209*^9, 3.9652696267997837`*^9}, {
   3.965270255741938*^9, 3.965270259877371*^9}, {3.9652712946405287`*^9, 
   3.965271295255185*^9}, 3.965271603375208*^9, {3.965271678021421*^9, 
   3.9652716785888023`*^9}, {3.965295155188463*^9, 3.965295170927732*^9}, {
   3.96529532978791*^9, 3.965295409347809*^9}, {3.965370905622148*^9, 
   3.965370910284832*^9}, {3.9654077338328114`*^9, 3.965407736918779*^9}, {
   3.965454099801641*^9, 3.965454140359528*^9}, {3.965511857868577*^9, 
   3.965511953921419*^9}},ExpressionUUID->"6f0188d9-1f30-4bdb-89ef-\
5561bfcbfab0"],

