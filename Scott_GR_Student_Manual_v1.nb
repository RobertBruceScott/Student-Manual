 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Part", " ", 
     RowBox[{"(", "c", ")"}]}], ":", " ", 
    RowBox[{"Computational", " ", "Cost", " ", "Estimation"}]}], "*)"}], "\n",
   "\n", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "part", " ", "is", " ", "broken", " ", "into", " ", "several",
     " ", "steps", " ", "to", " ", "build", " ", "up", " ", "the", " ", 
    "final", " ", "estimate", " ", "of", " ", "\n", "the", " ", "total", " ", 
    "computational", " ", 
    RowBox[{"cost", "."}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "constants", " ", "from", " ", "the", " ", "problem"}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Tobs", " ", "=", " ", "0.15*^8"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Observation", " ", "time", " ", "for", " ", "this", " ", "part", " ", 
     RowBox[{"(", 
      RowBox[{"6", " ", "months"}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"f0", " ", "=", " ", "2000"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Maximum", " ", "frequency", " ", "to", " ", "search", " ", "in", " ", 
     "Hz"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Deltaf", " ", "=", " ", "1.3*^-7"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Frequency", " ", "resolution", " ", "from", " ", "a", " ", "6"}], "-", 
     RowBox[{"month", " ", "observation"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"numSkyPatches", " ", "=", " ", "0.3*^13"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Number", " ", "of", " ", "independent", " ", "sky", " ", "patches", " ", 
     "to", " ", "search"}], " ", "*)"}], "\n", "\n"}]}]], "Code",
 CellChangeTimes->{{3.9631707773399153`*^9, 3.963170827732718*^9}, {
   3.963171021724777*^9, 3.963171084030089*^9}, {3.9631711420055656`*^9, 
   3.963171168109331*^9}, {3.963171394355028*^9, 3.963171394709832*^9}, 
   3.963171494419155*^9},
 CellLabel->
  "In[166]:=",ExpressionUUID->"94a472d6-4d70-413d-965a-c4d9e32c3074"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sub", "-", 
     RowBox[{"part", " ", 
      RowBox[{"(", "iii", ")"}]}]}], ":", " ", 
    RowBox[{
     RowBox[{"Maximum", " ", "Spin"}], "-", "Down"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "We", " ", "need", " ", "to", " ", "find", " ", "the", " ", "maximum", " ",
       "inverse", " ", "spin"}], "-", 
     RowBox[{"down", " ", "time"}]}], ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "\[Tau]"}], ")"}], "_max"}], ",", " ", 
