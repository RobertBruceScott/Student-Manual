Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2.3"}], ":", " ", 
    RowBox[{"The", " ", "Riemann", " ", "Tensor"}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Finally", ",", " ", 
    RowBox[{
    "we", " ", "calculate", " ", "the", " ", "Riemann", " ", "tensor"}], ",", 
    " ", 
    RowBox[{"R", "^", "\[Rho]\[Sigma]\[Mu]\[Nu]"}], ",", " ", 
    RowBox[{
    "using", " ", "its", " ", "definition", " ", "in", " ", "\n", "terms", " ",
      "of", " ", "the", " ", "Christoffel", " ", "symbols", " ", "and", " ", 
     "their", " ", 
     RowBox[{"derivatives", ":"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"R", "^", "k_lmn"}], " ", "=", " ", 
     RowBox[{"\[CapitalGamma]", "^", "k_ln"}]}], ",", 
    RowBox[{"m", " ", "-", " ", 
     RowBox[{"\[CapitalGamma]", "^", "k_lm"}]}], ",", 
    RowBox[{"n", " ", "+", " ", 
     RowBox[{
      RowBox[{"\[CapitalGamma]", "^", "k_sm"}], " ", "*", " ", 
      RowBox[{"\[CapitalGamma]", "^", "s_ln"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"\[CapitalGamma]", "^", "k_sn"}], " ", "*", " ", 
      RowBox[{"\[CapitalGamma]", "^", "s_lm"}]}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"First", ",", " ", 
    RowBox[{
    "we", " ", "need", " ", "the", " ", "derivatives", " ", "of", " ", "the", 
     " ", "Christoffel", " ", "symbols"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dchristoffel2", " ", "=", " ", 
     RowBox[{"D", "[", 
      RowBox[{"christoffel2", ",", " ", 
       RowBox[{"{", "coords", "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Now", " ", "we", " ", "can", " ", "assemble", " ", "the", " ", 
      "Riemann", " ", "tensor"}], ",", " ", 
     RowBox[{"R", "^", "k_lmn"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"riemann1up3down", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"dchristoffel2", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", " ", "l", ",", " ", "n", ",", " ", "m"}], "]"}], 
         "]"}], " ", "-", " ", 
        RowBox[{"dchristoffel2", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", " ", "l", ",", " ", "m", ",", " ", "n"}], "]"}], 
         "]"}], " ", "+", "\n", "    ", 
        RowBox[{"Sum", "[", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"christoffel2", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", " ", "s", ",", " ", "m"}], "]"}], "]"}], "*", 
            
            RowBox[{"christoffel2", "[", 
             RowBox[{"[", 
              RowBox[{"s", ",", " ", "l", ",", " ", "n"}], "]"}], "]"}]}], 
           " ", "-", " ", "\n", "      ", 
           RowBox[{
            RowBox[{"christoffel2", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", " ", "s", ",", " ", "n"}], "]"}], "]"}], "*", 
            
            RowBox[{"christoffel2", "[", 
             RowBox[{"[", 
              RowBox[{"s", ",", " ", "l", ",", " ", "m"}], "]"}], "]"}]}]}], ",",
           "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "1", ",", " ", "3"}], "}"}]}], "\n", 
         "     ", "]"}]}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "3"}], "}"}]}], "\n", "   ", 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Find", " ", "Ricci", " ", 
     RowBox[{"tensor", ":", " ", 
      RowBox[{
      "Contract", " ", "the", " ", "first", " ", "and", " ", "third", " ", 
       "indices", " ", "of", " ", "the", " ", "riemman", " ", "tensor"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"riemann4down", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{"s", ",", "k"}], "]"}], "]"}], "*", 
          RowBox[{"riemann1up3down", "[", 
           RowBox[{"[", 
            RowBox[{"s", ",", "l", ",", "m", ",", "n"}], "]"}], "]"}]}], ",", 
         "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "1", ",", " ", "3"}], "}"}]}], "\n", "     ",
         "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "1", ",", " ", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "1", ",", " ", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "3"}], "}"}]}], "\n", "   ", 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Displaying", " ", "the", " ", "Result"}], "*)"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "Riemann", " ", "tensor", " ", "has", " ", 
      RowBox[{"3", "^", "4"}]}], " ", "=", " ", 
     RowBox[{"81", " ", 
      RowBox[{"components", ".", " ", "Most"}], " ", "of", " ", "them", " ", 
      "are", " ", 
      RowBox[{"zero", "."}]}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"simplifiedAllComponents", " ", "=", " ", 
    RowBox[{"Simplify", "[", "riemann4down", "]"}]}]}]}]], "Code",
