Cell[CellGroupData[{

Cell[TextData[{
 "(b) Assuming that our knowledge of particle physics is uncertain for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]], 
         StyleBox["T", "TI"], ">", 
         SuperscriptBox["10", "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$k_B T > 10^3 $", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7ba6aae-b7b1-49e8-aee0-be11a4697dff"],
 "GeV, find the earliest time ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$t$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c36517c-47b2-4ebb-82a4-50194a9ec52f"],
 " at which we can have confidence in the physics."
}], "Subsubsection",
 CellChangeTimes->{{3.963609994921192*^9, 3.963609995920075*^9}, {
  3.9636100446184263`*^9, 3.963610086358336*^9}, {3.9636101278423233`*^9, 
  3.963610130316676*^9}},
 TextJustification->1.,ExpressionUUID->"9a2bad51-45c1-48d5-b637-ee39018a1a77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"We", " ", "set", " ", "kB", " ", "T"}], " ", "=", " ", 
     RowBox[{
     "1000", " ", "GeV", " ", "in", " ", "the", " ", "relation", " ", "above",
       " ", "for", " ", "T", " ", "as", " ", "a", " ", "function", " ", "of", 
      " ", "t"}]}], ",", " ", "\n", 
    RowBox[{"solve", " ", "for", " ", 
     RowBox[{"t", ":"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"t", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"beta", " ", "*", " ", 
       RowBox[{"kBeVperK", "/", 
        RowBox[{"Quantity", "[", 
         RowBox[{
          RowBox[{"10", "^", "12"}], ",", "\"\<Electronvolts\>\""}], 
         "]"}]}]}], ")"}], "^", "2"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Confirm", " ", "the", " ", "units", " ", "are", " ", "seconds"}],
     " ", "*)"}], " ", "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"t", ",", "\"\<Seconds\>\""}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.963610189457559*^9, 3.963610352494931*^9}, {
  3.963610400087576*^9, 3.9636104849324408`*^9}, {3.963610516661643*^9, 
  3.963610637421953*^9}, {3.9636106986010103`*^9, 3.963610749407401*^9}},
