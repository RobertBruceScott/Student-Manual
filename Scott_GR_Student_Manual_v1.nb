     " ", "\n", "displacements", " ", "over", " ", "a", " ", "150"}], "-", 
    RowBox[{
    "second", " ", "interval", " ", "to", " ", "the", " ", "final", " ", 
     "gravitational", " ", 
     RowBox[{"wavelength", "."}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Earth", "'"}], "s", " ", "Velocity", " ", "in", " ", "Orbit"}], 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", 
