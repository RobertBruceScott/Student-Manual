  RowBox[{"(*", 
   RowBox[{
   "The", " ", "Christoffel", " ", "symbols", " ", "are", " ", "calculated", " ",
     "from", " ", "the", " ", "derivatives", " ", "of", " ", "the", " ", 
    "metric", " ", "tensor", "\n", " ", "using", " ", "the", " ", 
    RowBox[{"formula", ":"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[CapitalGamma]", "^", "k_ij"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", "*", " ", 
     RowBox[{"g", "^", "kl"}], " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{"g_jl", ",", 
       RowBox[{"i", " ", "+", " ", "g_il"}], ",", 
       RowBox[{"j", " ", "-", " ", "g_ij"}], ",", "l"}], ")"}]}]}], "*)"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"First", ",", " ", 
    RowBox[{
    "calculate", " ", "all", " ", "the", " ", "first", " ", "partial", " ", 
     "derivatives", " ", "of", " ", "the", " ", "metric"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"dg", " ", "=", " ", 
    RowBox[{"D", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", "coords", "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "This", " ", "creates", " ", "a", " ", "nested", " ", "list", " ", "or", 
      " ", "table", " ", "with", " ", "three", " ", "indices", " ", "or", " ", 
      RowBox[{"iterators", ".", "\n", "The"}], " ", "convention", " ", "for", 
      " ", "the", " ", "nesting", " ", "order", " ", "is", " ", 
      RowBox[{"(", 
       RowBox[{"like", " ", "a", " ", "Python", " ", "Numpy", " ", "array"}], 
       ")"}], " ", "that", " ", "the", " ", "\n", "first", " ", "index", " ", 
      "is", " ", "the", " ", "outermost", " ", "loop", " ", 
      RowBox[{"(", 
       RowBox[{"slowest", " ", "varying"}], ")"}], " ", "and", " ", "the", " ",
       "last", " ", "index", "\n", "is", " ", "the", " ", "innermost", " ", 
      "loop", " ", 
      RowBox[{
       RowBox[{"(", 
