Cell[BoxData[
 RowBox[{"\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Analysis", " ", "and", " ", "Plotting", " ", "of", " ", 
    "Results"}], "*)"}], "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "With", " ", "the", " ", "solutions", " ", "for", " ", "each", " ", 
     "model"}], ",", " ", 
    RowBox[{
    "we", " ", "can", " ", "now", " ", "extract", " ", "the", " ", "stellar", 
     " ", "properties", "\n", " ", 
     RowBox[{"(", 
      RowBox[{
      "like", " ", "total", " ", "mass", " ", "M", " ", "and", " ", "radius", 
       " ", "R"}], ")"}], " ", "and", " ", "plot", " ", "the", " ", "results",
      " ", "as", " ", "requested", " ", "in", " ", "the", " ", "\n", " ", 
     RowBox[{"textbook", "."}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Extracting", " ", "Mass", " ", "and", " ", "Radius"}], "*)"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Extract", " ", "the", " ", "mass", " ", "and", " ", "pressure", " ", 
    "functions", " ", "from", " ", "the", " ", "solutions"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"massFunctions", " ", "=", " ", 
     RowBox[{"solutions", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pressureFunctions", " ", "=", " ", 
     RowBox[{"solutions", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Find", " ", "the", " ", "radius", " ", "R", " ", "and", " ", "total", " ",
      "mass", " ", "M", " ", "for", " ", "each", " ", "star"}], " ", "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "radius", " ", "is", " ", "the", " ", "upper", " ", "bound", " ",
      "of", " ", "the", " ", "domain", " ", "of", " ", "the", " ", "pressure",
      " ", "function"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", "\n", 
    RowBox[{"Unfortunately", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "the", " ", "two", " ", "lines", " ", "below", " ", "did", " ", "not", 
        " ", 
        RowBox[{"work", ":", "\n", "radii"}]}], " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pressureFunctions", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "solutions", "]"}]}], "}"}]}], "]"}]}], ";",
       "\n", 
      RowBox[{"masses", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"massFunctions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"radii", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "solutions", "]"}]}], "}"}]}], "]"}]}], ";",
       "\n", "\n", 
      RowBox[{
       RowBox[{
       "But", " ", "below", " ", "we", " ", "have", " ", "a", " ", "nice", " ",
         "example", " ", "of", " ", "how", " ", "to", " ", "display", " ", 
        "the", " ", 
        RowBox[{"results", " ", "!"}], "\n", "\n", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Display", " ", "the", " ", "results", " ", "in", " ", "a", " ", 
          "table"}], " ", "*)"}], "\n", "resultsTable"}], " ", "=", " ", 
       RowBox[{"Table", "[", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<\[Rho]c/\[Rho]*\>\"", " ", "->", " ", 
            RowBox[{"rhocRatios", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "\n", "   ", 
           RowBox[{"\"\<Radius R (m)\>\"", " ", "->", " ", 
            RowBox[{"Round", "[", 
             RowBox[{"radii", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", " ", "\n", "   ", 
           
           RowBox[{"\"\<Mass M (m)\>\"", " ", "->", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"masses", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", "0.1"}], "]"}]}], ",",
            "\n", "   ", 
           RowBox[{"\"\<M/R\>\"", " ", "->", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"masses", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"radii", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", "0.001"}], 
             "]"}]}]}], "}"}], ",", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "solutions", "]"}]}], "}"}]}], "\n", 
        "]"}]}], ";", "\n", "\n", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"resultsTable", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Model\>\"", ",", " ", "\"\<Radius R (m)\>\"", ",", 
            " ", "\"\<Mass M (m)\>\"", ",", " ", "\"\<M/R\>\""}], "}"}]}], 
         "]"}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", "\n", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plotting", " ", "Pressure", " ", 
     RowBox[{"vs", ".", " ", "Radius"}]}], "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "plot", " ", "shows", " ", "how", " ", "the", " ", 
     "pressure", " ", "p", 
     RowBox[{"(", "r", ")"}], " ", "drops", " ", "from", " ", "its", " ", 
     "central", " ", "value", " ", "to", " ", "zero", " ", "at", "\n", " ", 
     "the", " ", "surface", " ", "for", " ", "each", " ", 
     RowBox[{"model", "."}]}], "*)"}], "\n", "\n"}]}]], "Code",
 CellChangeTimes->{
  3.96526958595343*^9, 3.965409681346944*^9, 3.96541024332493*^9, {
   3.9654916317939672`*^9, 3.965491713781291*^9}},
 CellLabel->
  "In[2499]:=",ExpressionUUID->"4a2babba-1770-4690-96b1-ff44455effd6"],

