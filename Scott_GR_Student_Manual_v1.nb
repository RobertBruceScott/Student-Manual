   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Alternative", ":", " ", 
       RowBox[{
       "Taylor", " ", "expansion", " ", "of", " ", "the", " ", "Lorentz", " ",
         "factor", " ", "using", " ", "x"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "^", "2"}], " ", ".", " ", "\n", "This"}], " ", "leads", 
       " ", "to", " ", "the", " ", "same", " ", "result", " ", "but", " ", 
       "more", " ", "directly"}]}], ",", " ", 
     RowBox[{
     "avoiding", " ", "the", " ", "odd", " ", "power", " ", "terms", "\n", 
      "that", " ", "evaluated", " ", "to", " ", "zero", " ", 
      RowBox[{"above", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Here", " ", "is", " ", "the", " ", "function", " ", "definition", " ", 
     "for", " ", "the", " ", "Lorentz", " ", "factor"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lf", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Below", " ", "we", " ", "define", " ", "the", " ", "first", " ", 
     "derivative", " ", "with", " ", "respect", " ", "to", " ", 
     RowBox[{"x", ":"}]}], "*)"}], " ", "\n", 
   RowBox[{
    RowBox[{"d1x", " ", "=", " ", 
