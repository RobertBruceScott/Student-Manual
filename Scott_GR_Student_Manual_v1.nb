Cell[CellGroupData[{

Cell["Supplementary Problem 12.3", "Section",
 CellChangeTimes->{{3.963201853407297*^9, 
  3.96320189203544*^9}},ExpressionUUID->"54ab4d67-66b2-45d4-980c-\
92889dc0b603"],

Cell[CellGroupData[{

Cell[TextData[{
 "Here we consider the effect of the movement of a gravitational wave \
detector during a detection event and compare this to the wavelength of the \
gravitational waves. The duration of the detection event and the wavelength \
of the gravitational waves depends upon the source. To be concrete, consider \
the merger of neutron stars with masses ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1.4", 
         SubscriptBox[
          StyleBox["M", "TI"], "\[CircleDot]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$1.4 M_\\odot$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3eb57304-276a-490f-b56c-463c2395f59b"],
 ". We saw in Exercise 12.2 that the detection event duration in this case is \
about 150 s.\n"
}], "Subsection",
 CellChangeTimes->{{3.963201902620483*^9, 3.9632019161846857`*^9}, {
  3.9632019484678173`*^9, 3.963201985956923*^9}},
 TextJustification->1.,ExpressionUUID->"20baecce-995b-4cbc-a816-91bd15cfea25"],

Cell[CellGroupData[{

Cell["\<\
(a) Calculate the minimum wavelength of the gravitational waves.\
\>", "Subsubsection",
 CellChangeTimes->{
  3.963202075207552*^9},ExpressionUUID->"df7eb6e2-ceca-4ac4-bdbc-\
2d2abd23de8e"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "Necessary", " ", "Constants"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"First", ",", " ", 
    RowBox[{
    "we", " ", "define", " ", "the", " ", "physical", " ", "and", " ", 
     "astronomical", " ", "constants", " ", "used", " ", "in", " ", "the", 
     " ", "\n", 
     RowBox[{"calculations", ".", " ", "These"}], " ", "values", " ", "are", " ",
      "taken", " ", "from", " ", "earlier", " ", "sections", " ", "of", " ", 
     "the", " ", "textbook", " ", "for", " ", "\n", 
     RowBox[{"consistency", ".", " ", "The"}], " ", 
     RowBox[{"`N", "[", "]"}], "`", " ", "function", " ", "is", " ", "used", " ",
      "to", " ", "get", " ", "numerical", " ", "values", " ", "where", " ", "\n", 
     RowBox[{"appropriate", "."}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cSI", " ", "=", " ", "299792458"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Speed", " ", "of", " ", "light", " ", "in", " ", 
     RowBox[{"m", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"secperday", " ", "=", " ", 
     RowBox[{"3600", "*", "24"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secperyear", " ", "=", " ", 
     RowBox[{"365.2425", "*", "secperday"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"auSI", " ", "=", " ", "149597870700"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Astronomical", " ", "Unit", " ", "in", " ", "meters"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"lightyearSI", " ", "=", " ", 
     RowBox[{"365.2425", "*", "secperday", "*", "cSI"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"earthOmegaSI", " ", "=", " ", 
     RowBox[{"2", "*", 
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"23", "*", "3600"}], " ", "+", " ", 
         RowBox[{"56", "*", "60"}], " ", "+", " ", "4.091"}], ")"}]}]}]}], 
    ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Earth", "'"}], "s", " ", "rotational", " ", "angular", " ", 
     "velocity", " ", "in", " ", 
     RowBox[{"rad", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"earthEquatorialRadiusSI", " ", "=", " ", "6378137"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Earth", "'"}], "s", " ", "equatorial", " ", "radius", " ", "in",
      " ", "meters"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Chirp", " ", "Mass", " ", "of", " ", "a", " ", "Neutron", " ", "Star", " ",
      "Binary"}], "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Maple", " ", "uses", " ", "`"}], ":=", 
      RowBox[{
      "`", " ", "for", " ", "assignment", " ", "and", " ", "`subs`", " ", 
       "for", " ", 
       RowBox[{"substitution", ".", " ", "\n", "In"}], " ", "Mathematica"}]}],
      ",", " ", 
     RowBox[{
      RowBox[{
      "we", " ", "define", " ", "a", " ", "function", " ", "for", " ", "the", 
       " ", "chirp", " ", "mass", " ", "using", " ", "`"}], ":=", 
      RowBox[{
      "`", " ", "and", " ", "then", " ", "\n", "call", " ", "that", " ", 
       "function", " ", "with", " ", "the", " ", "specific", " ", "mass", " ", 
       RowBox[{"values", "."}]}]}]}], "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Chirp", " ", "Mass", " ", "Function", " ", 
     RowBox[{"(", 
      RowBox[{"from", " ", "Schutz", " ", 
       RowBox[{"Eq", ".", " ", "9.151"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mChirp", "[", 
     RowBox[{"m1_", ",", " ", "m2_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m1", "*", "m2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "5"}], ")"}]}], " ", "/", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m1", " ", "+", " ", "m2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "5"}], ")"}]}]}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Calculate", " ", "the", " ", "chirp", " ", "mass", " ", "for", " ", 
     "two", " ", "1.4", " ", "solar", " ", "mass", " ", "neutron", " ", 
     "stars"}], " ", "*)"}], "\n", 
   RowBox[{"mChirpValue", " ", "=", " ", 
    RowBox[{"mChirp", "[", 
     RowBox[{"1.4", ",", " ", "1.4"}], "]"}]}]}]}]], "Code",
 CellChangeTimes->{
  3.9632019227679768`*^9, {3.9632020936745167`*^9, 3.963202122125201*^9}, {
   3.963202541110208*^9, 3.963202639747107*^9}},
 CellLabel->
