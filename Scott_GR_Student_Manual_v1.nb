   RowBox[{
   "1.", " ", "execute", " ", "the", " ", "cell", " ", "of", " ", "the", " ", 
    "previous", " ", "Exercise", " ", "13.6"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "which", " ", "will", " ", "calculate", " ", "the", " ", "Riemann", " ", 
    "Tensor", " ", "from", " ", "First", " ", "Principles"}], " ", "*)"}], 
  "\n", "\n"}]], "Code",
