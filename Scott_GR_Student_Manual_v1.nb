     RowBox[{
      RowBox[{"The", " ", "second", " ", 
       RowBox[{"(", 
        RowBox[{"non", "-", "zero"}], ")"}], " ", "term", " ", "contains", " ",
        "the", " ", "second"}], "-", 
      RowBox[{
      "order", " ", "derivative", " ", "of", " ", "the", " ", "function", " ",
        "\n", "evaluated", " ", "at", " ", "v"}]}], "=", "0"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"d2", " ", "=", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"lfTrue", "[", "v", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", "2"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\n", 
   RowBox[{"term2", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"d2", " ", "/.", " ", 
       RowBox[{"v", " ", "->", " ", "0"}]}], ")"}], "/", 
     RowBox[{"Factorial", "[", "2", "]"}]}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "The", " ", "third", " ", "order", " ", "term", " ", "contains", " ", 
       "the", " ", "third"}], "-", 
      RowBox[{"order", " ", "derivative", " ", "of", " ", "the", " ", 
       RowBox[{"function", " ", "\n", ".", " ", "When"}], " ", "evaluated", " ",
        "at", " ", "v"}]}], "=", 
     RowBox[{"0", " ", "this", " ", "term", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"and", " ", "all", " ", "odd"}], "-", 
