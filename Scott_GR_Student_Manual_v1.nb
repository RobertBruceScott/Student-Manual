  RowBox[{"\[Pi]", "\n", "\[Psi]", "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Text", "::"}], " ", "*)"}], "\n", 
   RowBox[{"(*", 
