     RowBox[{"(", 
      RowBox[{"Schutz", ",", " ", 
       RowBox[{"Eq", ".", " ", "10.93"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhostar", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"27", "*", 
         RowBox[{"kGU", "^", "3"}]}], ")"}]}], "]"}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{
  3.965263348237855*^9, {3.965263395094975*^9, 3.965263473421803*^9}, {
   3.965263516437557*^9, 3.9652635299549828`*^9}, {3.965263757480715*^9, 
