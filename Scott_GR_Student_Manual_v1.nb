      RowBox[{
      "capital", " ", "letters", " ", "for", " ", "the", " ", "first", " ", 
       "letter", " ", "is", " ", "reserved", " ", "for", " ", "Mathematica", " ",
        "build"}], "-", 
      RowBox[{"in", " ", "\n", 
       RowBox[{"functions", "."}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"lfTrue", "[", "v_", "]"}], " ", ":=", " ", 
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"v", "^", "2"}]}], "]"}]}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Series", " ", "expansion", " ", "of", " ", "Ftrue", " ", "around", " ", 
      "v"}], " ", "=", " ", 
