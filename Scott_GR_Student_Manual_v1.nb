    "for", " ", "a", " ", "\n", "pulsar", " ", "that", " ", "slows", " ", 
     "from", " ", "2000", " ", "Hz", " ", "to", " ", "1000", " ", "Hz", " ", 
     "in", " ", "1000", " ", 
     RowBox[{"years", "."}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
