      RowBox[{
       RowBox[{"(", "\[Mu]", ")"}], "."}]}]}], "*)"}], "\n", "\n", 
   RowBox[{"M", " ", "=", " ", 
    RowBox[{"m1", " ", "+", " ", "m2"}]}], "            ", 
   RowBox[{"(*", " ", 
    RowBox[{"Scott", " ", 
     RowBox[{"eqn", ".", 
      RowBox[{"(", "12.100", ")"}]}]}], " ", "*)"}], "\n", 
