Cell[CellGroupData[{

Cell["Exercise 12.7 (f)", "Section",
 CellChangeTimes->{{3.96302293020009*^9, 3.963022933751161*^9}, {
  3.963024243501752*^9, 
  3.963024247568816*^9}},ExpressionUUID->"da39528d-9ff7-4982-ab43-\
b1a6de1c14f4"],

Cell[CellGroupData[{

Cell["\<\
Here we explore solving Eq.(12.26) for the inclination angle iota.\
\>", "Subsection",
 CellChangeTimes->{{3.963024282075738*^9, 
  3.9630243096027937`*^9}},ExpressionUUID->"d09bd058-737c-403f-849a-\
9467f3f58b77"],

Cell[CellGroupData[{

Cell["\<\
(f) This result shows that iota needs to get fairly large before epsilon \
becomes measurable, or equivalently the ratio r becomes measurably different \
from 1. Suppose that r is measured to be 1, with an error of 1%. Show that \
iota might be as large as 0.53 radians or 30\[Degree].\
\>", "Subsubsection",
 CellChangeTimes->{{3.963024313402711*^9, 3.963024411659811*^9}, {
  3.9631022951819077`*^9, 3.9631023047897053`*^9}},
 TextJustification->1.,ExpressionUUID->"a539a17a-1bed-4b49-ada3-5826a5a82c2e"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Exercise", " ", "12.7", 
     RowBox[{"(", "f", ")"}], " ", "asks", " ", "us", " ", "to", " ", 
     "explore", " ", "the", " ", "uncertainty", " ", "in", " ", "measuring", " ",
      "the", " ", "\n", "inclination", " ", "angle"}], ",", " ", "\[Iota]", ",",
     " ", 
    RowBox[{
     RowBox[{"of", " ", "a", " ", "nearly", " ", "face"}], "-", 
     RowBox[{"on", " ", "binary", " ", 
      RowBox[{"system", ".", " ", "\n", "Specifically"}]}]}], ",", " ", 
    RowBox[{"it", " ", 
     RowBox[{
     "states", ":", 
      "\n", "\"\<Suppose that r is measured to be 1, with an error of 1%. \
Show that \[Iota] might \nbe as large as 0.53 radians, or \
30\[Degree].\>\""}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Here", ",", " ", 
    RowBox[{
    "`r`", " ", "is", " ", "the", " ", "ratio", " ", "of", " ", "the", " ", 
     "measured", " ", "polarization", " ", "amplitudes"}], ",", " ", 
    RowBox[{"|", 
     RowBox[{"h", "+"}], "|", 
     RowBox[{"/", 
      RowBox[{"|", 
       RowBox[{"h", "\[Times]"}], "|"}]}]}], ",", " ", "\n", 
    RowBox[{
    "and", " ", "\[Iota]", " ", "is", " ", "the", " ", "inclination", " ", 
     "angle", " ", "of", " ", "the", " ", 
     RowBox[{"binary", "'"}], "s", " ", "orbit", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"where", " ", "\[Iota]"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"0", " ", "is", " ", "a", " ", "\n", "face"}], "-", 
         RowBox[{"on", " ", "orbit"}]}]}], ")"}], "."}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "problem", " ", "states", " ", "that", " ", "`r`", " ", "is", 
     " ", "measured", " ", "to", " ", "be", " ", "1", " ", "with", " ", "an", 
     " ", "error", " ", "of", " ", "1", 
     RowBox[{"%", ".", " ", "We"}], " ", "have", " ", "constructed", "\n", 
     "r"}], " ", ">=", " ", 
    RowBox[{
    "1", " ", "so", " ", "this", " ", "means", " ", "the", " ", "likely", " ",
      "measured", " ", "value", " ", "could", " ", "be", " ", "up", " ", "to",
      " ", "1.01"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "We", " ", "could", " ", "simply", " ", "apply", " ", "the", " ", 
      "arccos", " ", "function", " ", "to", " ", "Scott", " ", "eqn", 
      RowBox[{"(", "12.37", ")"}]}], ":", "\n", "z"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"r", " ", "-", " ", 
      RowBox[{"sqrt", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", "-", " ", "1"}], ")"}]}]}], " ", "=", 
     " ", 
     RowBox[{
      RowBox[{"cos", 
       RowBox[{"(", "\[Iota]", ")"}], "\n", "\[Iota]"}], " ", "=", " ", 
      RowBox[{"arccos", 
       RowBox[{"(", "z", ")"}]}]}]}]}], "\n", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"inclinationAngle", "[", "r_", "]"}], " ", ":=", 
    RowBox[{"ArcCos", "[", 
     RowBox[{"r", "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "-", "1"}], "]"}]}], "]"}]}], "\n", 
   RowBox[{"iotaDirect", "=", 
    RowBox[{"inclinationAngle", "[", "1.01", "]"}]}], "\n"}]}]], "Code",
 CellChangeTimes->{
  3.9630244165018053`*^9, {3.963028276996719*^9, 3.963028394793254*^9}, {
   3.96304588471502*^9, 3.963045888754323*^9}, {3.963046027135779*^9, 
