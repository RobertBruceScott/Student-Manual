Cell["\<\
We can use Mathematica to find and display only the unique, non-zero \
components. But first we must convert the nested list of lists into one big \
list of elements:\
\>", "Text",
 CellChangeTimes->{{3.9634369814505053`*^9, 3.963436984330268*^9}, {
  3.9634372714762697`*^9, 3.963437315717111*^9}},
 TextJustification->1.,ExpressionUUID->"b9e83f17-5862-480d-b984-fd04522fbd03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"simplifiedUniqueComponents", " ", "=", " ", 
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{"Flatten", "[", "simplifiedAllComponents", "]"}], "]"}]}]], "Code",\

 CellChangeTimes->{
  3.963437358113701*^9, {3.963437406218135*^9, 3.963437423757728*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"574508a9-4b52-4492-ac67-bb3c38f699e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"r", " ", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}]}], ",", 
   RowBox[{
    RowBox[{"-", "r"}], " ", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}]}], ",", 
   RowBox[{"r", " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}]}], ",", 
   RowBox[{
    RowBox[{"-", "r"}], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}]}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}]]}], ")"}], " ", 
    SuperscriptBox["r", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}]]}], ")"}], " ", 
    SuperscriptBox["r", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"\[Lambda]", "[", "r", "]"}]}]]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}]]}], ")"}], " ", 
    SuperscriptBox["r", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"\[Lambda]", "[", "r", "]"}]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}]]}], ")"}], " ", 
    SuperscriptBox["r", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9635317846758223`*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"c7177fdc-0896-4f88-8ab1-9f92c29393d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nonZeroComponents", " ", "=", " ", 
  RowBox[{"Select", "[", 
   RowBox[{"simplifiedUniqueComponents", ",", 
    RowBox[{
     RowBox[{"UnsameQ", "[", 
      RowBox[{"#", ",", "0"}], "]"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.963434677391211*^9, 3.96343473501119*^9}, {
