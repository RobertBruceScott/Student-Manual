Cell[CellGroupData[{

Cell["\<\
Find a power series expansion of the T-O-V equation and mass continuity \
equation about r=0.\
\>", "Subsection",
 CellChangeTimes->{{3.965347041184935*^9, 
  3.9653471095762672`*^9}},ExpressionUUID->"fa7dadcd-94f2-4270-898f-\
7c43474ce080"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Package", "::"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Mathematica", " ", "code", " ", "to", " ", "derive", " ", "the", " ", 
    "series", " ", "expansion", " ", "coefficients", " ", "for", " ", "the"}],
    " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Tolman", "-", "Oppenheimer", "-", 
     RowBox[{"Volkoff", " ", 
      RowBox[{"(", 
       RowBox[{"T", "-", "O", "-", "V"}], ")"}], " ", "equations", " ", 
      "near", " ", "r"}]}], "=", "0."}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Set", " ", "head", " ", "for", " ", "output", " ", "sections", " ", 
     "for", " ", "clarity"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"section", "[", "title_", "]"}], " ", ":=", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"title", ",", " ", "\"\<Section\>\"", ",", " ", "Bold"}], 
       "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
    "section", 
     "[", "\"\<1. Define Series Expansions and Equation of State\>\"", "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Define", " ", "the", " ", "power", " ", "series", " ", "for", " ", 
      "pressure", " ", "p", 
      RowBox[{"(", "r", ")"}]}], ",", " ", 
     RowBox[{"mass", " ", "m", 
      RowBox[{"(", "r", ")"}]}], ",", " ", 
     RowBox[{"and", " ", "density", " ", "rho", 
      RowBox[{"(", "r", ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "go", " ", "to", " ", "a", " ", "sufficiently", " ", "high", " ",
      "order", " ", "to", " ", "solve", " ", "for", " ", 
     RowBox[{"p4", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"pc", " ", "+", " ", 
      RowBox[{"p2", " ", 
       RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"p4", " ", 
       RowBox[{"r", "^", "4"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"m", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"m3", " ", 
       RowBox[{"r", "^", "3"}]}], " ", "+", " ", 
      RowBox[{"m5", " ", 
       RowBox[{"r", "^", "5"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "density", " ", "rho", " ", "is", " ", "a", " ", "function", 
      " ", "of", " ", "pressure", " ", "p"}], ",", " ", 
     RowBox[{"via", " ", "the", " ", "Equation", " ", "of", " ", "State", " ", 
      RowBox[{
       RowBox[{"(", "EoS", ")"}], "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"We", " ", "expand", " ", "rho", 
      RowBox[{"(", "p", ")"}], " ", "as", " ", "a", " ", "Taylor", " ", 
      "series", " ", "around", " ", "the", " ", "central", " ", "pressure"}], 
     ",", " ", 
     RowBox[{"pc", "."}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"drhodp_c", " ", "is", " ", 
     RowBox[{"(", 
      RowBox[{"d\[Rho]", "/", "dp"}], ")"}], " ", "at", " ", "the", " ", 
     RowBox[{"center", "."}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"d2rhodp2_c", " ", "is", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"d", "^", "2"}], 
       RowBox[{"\[Rho]", "/", 
        RowBox[{"dp", "^", "2"}]}]}], ")"}], " ", "at", " ", "the", " ", 
     RowBox[{"center", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rho_eos", "[", "p_", "]"}], " ", ":=", " ", 
     RowBox[{"rhoc", " ", "+", " ", 
      RowBox[{"drhodp_c", " ", 
       RowBox[{"(", 
        RowBox[{"p", " ", "-", " ", "pc"}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "d2rhodp2_c", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", " ", "-", " ", "pc"}], ")"}], "^", "2"}]}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Now", " ", "find", " ", "the", " ", "series", " ", "for", " ", "rho", 
     RowBox[{"(", "r", ")"}], " ", "by", " ", "substituting", " ", "p", 
     RowBox[{"(", "r", ")"}], " ", "into", " ", "the", " ", "EoS", " ", 
     RowBox[{"expansion", "."}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"We", " ", "use", " ", 
     RowBox[{"Series", "[", "]"}], " ", "to", " ", "handle", " ", "the", " ", 
     "expansion", " ", "and", " ", 
     RowBox[{"Normal", "[", "]"}], " ", "to", " ", "convert", " ", "it", " ", 
     "to", " ", "a", " ", "regular", " ", 
     RowBox[{"polynomial", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", "r_", "]"}], " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"rho_eos", "[", 
         RowBox[{"p", "[", "r", "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}],
     ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Pressure p(r) = \>\"", ",", " ", 
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"p", "[", "r", "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mass m(r) = \>\"", ",", " ", 
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"m", "[", "r", "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Density rho(r) = \>\"", ",", " ", 
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"rho", "[", "r", "]"}], "]"}]}], "]"}], ";"}], "\n", 
   "\n"}]}]], "Code",
 CellChangeTimes->{
  3.965347089082445*^9, 3.965355709961075*^9, {3.9653557845788927`*^9, 
   3.965355789936078*^9}, 3.965355866398512*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"adf194a9-1c81-4b98-a639-c913f83e800a"],

