Cell["\<\
Mathematica Tip: We cannot simply compare the elements of the list directly \
to zero, as in the following line of code. This fails because the elements \
are symbolic expressions and Mathematica doesn\[CloseCurlyQuote]t know if \
they are 0 or not (we haven\[CloseCurlyQuote]t told it what lambda(r) is \
yet). The result of such an uncomparable expression is nothing.\
\>", "Text",
 CellChangeTimes->{{3.963436486628935*^9, 3.963436662772541*^9}, {
  3.963436828248148*^9, 3.96343683834641*^9}},
 TextJustification->1.,ExpressionUUID->"016a93d4-5dbd-4e4d-a392-80fe202629c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nonZeroComponents", " ", "=", " ", 
  RowBox[{"Select", "[", 
   RowBox[{"simplifiedAllComponents", ",", " ", 
    RowBox[{
     RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}]}], "]"}]}]], "Code",
 CellChangeTimes->{3.963436475099882*^9, 3.9634368432271223`*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"16f88b10-4ae0-4fa9-9302-5667828c3571"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellChangeTimes->{3.963531799901232*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"26301ea9-d99c-480e-83b1-394033350cf0"]
}, Open  ]],

Cell["Mathematica apparently knows how to simplify the following:", "Text",
 CellChangeTimes->{{3.963441565399375*^9, 3.96344161576937*^9}, {
  3.9634416563788958`*^9, 
  3.963441668285439*^9}},ExpressionUUID->"acfc431a-320f-4a2d-b86a-\
eda14fb78a38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"F", "[", "r", "]"}]}], "]"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{"F", "[", "r", "]"}], "]"}]}], "]"}]], "Code",
 CellChangeTimes->{3.9634415468045397`*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"5af06494-ff85-42e6-95c9-f5ad6a78e0fc"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.963531807211904*^9},
