Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "section", "[", "\"\<2. Set up the Stellar Structure Equations\>\"", "]"}],
    ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Mass", " ", "continuity", " ", 
     RowBox[{"equation", ":", " ", 
      RowBox[{"dm", "/", "dr"}]}]}], " ", "=", " ", 
    RowBox[{"4", "\[Pi]", " ", 
     RowBox[{"r", "^", "2"}], " ", "\[Rho]"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"massEq", " ", "=", " ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"m", "[", "r", "]"}], ",", " ", "r"}], "]"}], " ", "-", " ", 
     RowBox[{"4", " ", "\[Pi]", " ", 
      RowBox[{"r", "^", "2"}], " ", 
      RowBox[{"rho", "[", "r", "]"}]}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"T", "-", "O", "-", 
     RowBox[{"V", " ", "equation", " ", "for", " ", "hydrostatic", " ", 
      RowBox[{"equilibrium", ":", " ", 
       RowBox[{"dp", "/", "dr"}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", " ", 
      RowBox[{"(", 
       RowBox[{"\[Rho]", "+", "p"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "+", 
        RowBox[{"4", "\[Pi]", " ", 
         RowBox[{"r", "^", "3"}], " ", "p"}]}], ")"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", "m"}]}], ")"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "write", " ", "it", " ", "as", " ", "an", " ", "expression", " ",
     "that", " ", "should", " ", "equal", " ", 
    RowBox[{"zero", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
