52bb701d9e30"],

Cell["\<\
Mathematica Limit: And yet it didn\[CloseCurlyQuote]t know that the last pair \
of elements were equivalent to the previous pair in \
\[OpenCurlyDoubleQuote]nonZeroComponents\[CloseCurlyDoubleQuote] above.\
\>", "Text",
 CellChangeTimes->{{3.963441679849126*^9, 3.9634417438589487`*^9}, {
  3.963532251659039*^9, 3.963532259432454*^9}},
 TextJustification->1.,ExpressionUUID->"d3f5af7f-80b1-4443-955e-3829064ffe45"],

Cell[BoxData[
 RowBox[{"\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"As", " ", "the", " ", "output", " ", "shows"}], ",", " ", 
    RowBox[{
    "the", " ", "components", " ", "of", " ", "the", " ", "Riemann", " ", 
     "tensor", " ", "are", " ", 
     RowBox[{"generally", " ", "**", "not"}], " ", "\n", 
     RowBox[{
      RowBox[{"zero", "**"}], ".", " ", "They"}], " ", "depend", " ", "on", " ",
      "the", " ", "function", " ", 
     RowBox[{"\[Lambda]", "[", "r", "]"}], " ", "and", " ", "its", " ", 
     RowBox[{"derivative", "."}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "To", " ", "complete", " ", "the", " ", "exercise", " ", "and", " ", 
     "check", " ", "for", " ", "flatness"}], ",", " ", 
    RowBox[{
    "one", " ", "must", " ", "substitute", " ", "the", " ", "\n", "specific", 
     " ", "form", " ", "for", " ", 
     RowBox[{"\[Lambda]", "[", "r", "]"}], " ", "that", " ", "corresponds", " ",
      "to", " ", "a", " ", "homogeneous", " ", "and", " ", "isotropic", " ", 
     "space"}], ",", " ", "\n", 
    RowBox[{
     RowBox[{"which", " ", "is", " ", "given", " ", "in", " ", 
      RowBox[{"Schutz", "'"}], "s", " ", "Equation", " ", 
      RowBox[{"(", "13.12", ")"}]}], ":"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"2", 
      RowBox[{"\[Lambda]", "[", "r", "]"}]}], "]"}], " ", "=", " ", 
    RowBox[{"1", " ", "/", " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}], " ", "k", " ", 
        RowBox[{"r", "^", "2"}]}], "  ", "-", " ", 
       RowBox[{"A", "/", "r"}]}], " ", ")"}]}]}], "*)"}]}]], "Code",
 CellChangeTimes->{{3.963442337113064*^9, 3.96344234917248*^9}, {
  3.963442391244972*^9, 3.963442402124825*^9}, {3.963442549629231*^9, 
  3.963442568469201*^9}, {3.963442655825555*^9, 
  3.9634427425866756`*^9}},ExpressionUUID->"bcb4275a-ea93-4bb9-a0fe-\
b24780589c48"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercise 13.15", "Section",
 CellChangeTimes->{{3.963534957525811*^9, 
  3.963534962977291*^9}},ExpressionUUID->"4dc6aefc-9f0c-4a9c-82d1-\
ceeebe125bc8"],

Cell[TextData[{
 "The integral over the black-body spectrum times the energy per photon ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Nu]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$h\\nu$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc2b0929-f4fd-4d9e-b25f-40d9d835f48b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$h$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1860343f-255a-444d-9b2e-4323b822a17e"],
 " is Planck\[CloseCurlyQuote]s constant and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "$\\nu$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bfc36012-af55-417a-b4d9-d5ea6924ac0c"],
 " is the photon frequency) gives the total radiation energy density\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[Rho]", 
                    SuperscriptBox[
                    StyleBox["c", "TI"], "2"], "\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["a", "TI"], 
                    StyleBox["B", "TI"]], 
                    SuperscriptBox[
                    StyleBox["T", "TI"], "4"], ","}]], "InlineFormula"], 
                " "}], CellTags -> "eqn:ex12.15.1"]}}], TraditionalForm]]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\begin{align} \\label{eqn:ex12.15.1}\n\\rho c^2 = a_B T^4,\n\
\\end{align}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "741399fb-0866-4db3-a4b3-954c5879773e"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["B", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$a_B$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dbed659f-a044-4d7c-8d1f-21c5bd6fc131"],
 " is the radiation constant. Here is the integral over all frequencies:"
}], "Text",
 CellChangeTimes->{{3.963535155783885*^9, 3.963535171728355*^9}, {
  3.96353523233361*^9, 3.9635353499564342`*^9}},
 TextJustification->1.,ExpressionUUID->"9c3d4341-0518-41f4-96c7-a0efad2185f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Assumptions", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"$Assumptions", " ", "=", " ", 
     RowBox[{
      RowBox[{"T", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"kB", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"h", " ", ">", " ", "0"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Planck", " ", "spectrum", " ", "integral", " ", "over", " ", 
     "frequency"}], " ", "*)"}], "\n", 
   RowBox[{"Integrate", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"8", " ", "Pi", " ", "h", " ", 
        RowBox[{"\[Nu]", "^", "3"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"h", " ", 
          RowBox[{"\[Nu]", "/", 
           RowBox[{"(", 
            RowBox[{"kB", " ", "T"}], ")"}]}]}], "]"}], " ", "-", " ", "1"}], 
       ")"}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\[Nu]", ",", " ", "0", ",", " ", "Infinity"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"Assumptions", " ", "->", " ", "$Assumptions"}]}], "\n", "]"}], 
   "\n"}]}]], "Code",
 CellChangeTimes->{3.9635349701392736`*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"938b637f-d088-4cb8-834e-5789038fa86a"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SuperscriptBox["kB", "4"], " ", 
   SuperscriptBox["\[Pi]", "5"], " ", 
   SuperscriptBox["T", "4"]}], 
  RowBox[{"15", " ", 
   SuperscriptBox["h", "3"]}]]], "Output",
 CellChangeTimes->{3.96353497678728*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"9869b6f3-9822-454e-875f-c553f969bbc3"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercise 13.19", "Section",
 CellChangeTimes->{{3.963602038821698*^9, 
  3.963602043982535*^9}},ExpressionUUID->"7557fe22-0222-4eca-9108-\
4e6071dbb3b0"],

Cell[CellGroupData[{

Cell[TextData[{
 "From our earlier result in Scott eqn.(13.56), we have\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  SubscriptBox[
                   StyleBox["t", "TI"], "0"]], "InlineFormula"], " "}], 
              CellTags -> "eqn:13.19.9"], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    FractionBox["2", 
                    RowBox[{"3", 
                    SubscriptBox[
                    StyleBox["H", "TI"], "0"]}]], "."}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{align}\\label{eqn:13.19.9}\nt_0 &=\\frac{2}{3H_0}.\n\
\\end{align}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fcdd3e1-0955-48be-ae2c-6e065a3266cc"],
 "\nFinding a numerical value for the age of the Universe, we must be careful \
of the units. An approximate value of the Hubble constant is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], "0"], "\[LongEqual]", "70", 
         RowBox[{" km s", 
           Cell[
            BoxData[
             SuperscriptBox["\[Null]", "-1"]], "InlineFormula"], " Mparsec", 
           Cell[
            BoxData[
             SuperscriptBox["\[Null]", "-1"]], "InlineFormula"]}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$H_0 = 70 \\mbox{ km s$^{-1}$ Mparsec$^{-1}$}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "171d7d18-6ee8-4967-b50f-51cb8e8becaf"],
 ". Recall, 1 parsec = 30 856 775 814 671.9 km.\nThis gives :"
}], "Subsection",
 CellChangeTimes->{
  3.9636020532208023`*^9, 3.9636020916416187`*^9, {3.963602218276651*^9, 
   3.9636022207385807`*^9}, {3.96360226936384*^9, 3.963602310327243*^9}, {
