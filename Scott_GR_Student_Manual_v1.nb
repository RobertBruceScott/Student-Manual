Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sub", "-", 
     RowBox[{"part", " ", 
      RowBox[{"(", "iv", ")"}]}]}], ":", " ", 
    RowBox[{"Spin", "-", 
     RowBox[{"Down", " ", "Resolution"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Next", ",", " ", 
    RowBox[{
     RowBox[{
     "we", " ", "find", " ", "the", " ", "resolution", " ", "with", " ", 
      "which", " ", "we", " ", "can", " ", "measure", " ", "the", " ", 
      "spin"}], "-", 
     RowBox[{"down", " ", "\n", "parameter"}]}], ",", " ", 
