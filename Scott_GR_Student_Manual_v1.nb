    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "calculation", " ", "demonstrates", " ", "an", " ", 
      "important", " ", "concept", " ", "in", " ", "parameter", " ", 
      "estimation", " ", "\n", "for", " ", "binary", " ", 
      RowBox[{"systems", ".", " ", "Even"}], " ", "though", " ", "the", " ", 
      "total", " ", "mass", " ", "M", " ", "is", " ", "determined", " ", 
      "with", " ", "a", " ", "relatively", "\n", " ", "small", " ", 
      "uncertainty", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"in", " ", "this", " ", "case"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"+", "0.04"}], "/", 
          RowBox[{"-", "0.01"}]}], " ", "M_O"}]}], ")"}]}], ",", " ", 
     RowBox[{
     "the", " ", "uncertainties", " ", "in", " ", "the", " ", "\n", " ", 
      "individual", " ", "component", " ", "masses", " ", "can", " ", "be", " ",
       "much", " ", 
      RowBox[{"larger", "."}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "reason"}], ",", " ", 
