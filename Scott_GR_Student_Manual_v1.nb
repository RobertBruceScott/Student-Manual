Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Density rho(r) = \"\>", "\[InvisibleSpace]", 
   TagBox[
    FormBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["r", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          SuperscriptBox["p2", "2"], " ", 
          RowBox[{
           SuperscriptBox["rho_eos", "\[Prime]\[Prime]",
            MultilineFunction->None], "(", "pc", ")"}]}], "+", 
         RowBox[{"p4", " ", 
          RowBox[{
           SuperscriptBox["rho_eos", "\[Prime]",
            MultilineFunction->None], "(", "pc", ")"}]}]}], ")"}]}], "+", 
      RowBox[{"p2", " ", 
       SuperscriptBox["r", "2"], " ", 
       RowBox[{
        SuperscriptBox["rho_eos", "\[Prime]",
         MultilineFunction->None], "(", "pc", ")"}]}], "+", 
      RowBox[{"rho_eos", "(", "pc", ")"}]}],
     TraditionalForm],
    TraditionalForm,
    Editable->True]}],
  SequenceForm["Density rho(r) = ", 
   TraditionalForm[Pattern[$CellContext`rho, 
      Blank[$CellContext`eos]][$CellContext`pc] + $CellContext`p2 \
$CellContext`r^2 Derivative[1][
       Pattern[$CellContext`rho, 
        Blank[$CellContext`eos]]][$CellContext`pc] + $CellContext`r^4 \
($CellContext`p4 Derivative[1][
         Pattern[$CellContext`rho, 
          Blank[$CellContext`eos]]][$CellContext`pc] + 
      Rational[1, 2] $CellContext`p2^2 Derivative[2][
         Pattern[$CellContext`rho, 
          Blank[$CellContext`eos]]][$CellContext`pc])]],
  Editable->False]], "Print",
