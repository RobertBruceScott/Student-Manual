Cell[CellGroupData[{

Cell["Chapter 12: Gravitational wave astronomy", "Chapter",
 CellChangeTimes->{{3.96267582750273*^9, 3.962675846278364*^9}, {
  3.962675886658391*^9, 
  3.962675892205656*^9}},ExpressionUUID->"6c62b012-f7d3-4e86-baca-\
1d50f49a455e"],

Cell[CellGroupData[{

Cell["Exercise 12.1", "Section",
 CellChangeTimes->{{3.9626758722049313`*^9, 3.9626758778077507`*^9}, {
  3.962699699197023*^9, 
  3.962699703418517*^9}},ExpressionUUID->"a8556aa7-f174-40d6-a7df-\
ad2ddbdc51a2"],

Cell[CellGroupData[{

Cell["\<\
Use Eq. 12.2 to find the final gravitation wave frequencies at merger of \
pairs of equal-mass black holes of masses 10, million and billion solar \
masses, respectively.\
\>", "Subsection",
 CellChangeTimes->{{3.962676040738818*^9, 3.962676104462161*^9}, 
   3.962699721104084*^9},ExpressionUUID->"efcfaa2c-50ec-4de4-a274-\
9d76776db5e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "problem", " ", "provides", " ", "the", " ", "key", " ", 
     "formula"}], ",", " ", 
    RowBox[{
     RowBox[{
     "which", " ", "is", " ", "also", " ", "derived", " ", "and", " ", 
      "discussed", " ", "in", "\n", " ", "Section", " ", "12.2", " ", "of", " ",
       "the", " ", 
      RowBox[{"textbook", ".", "\n", "The"}], " ", "formula", " ", "is", " ", 
      "given", " ", 
      RowBox[{"as", ":", " ", "\n", "ffinal"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"4.0", " ", "/", " ", "Mchirp"}], "\n", "where", " ", "ffinal", 
      " ", "is", " ", "the", " ", "final", " ", "frequency", " ", "in", " ", 
      "kHz", " ", "and", " ", "Mchirp", " ", "is", " ", "the", 
      " ", "\"\<chirp mass\>\"", " ", "of", " ", "\n", "the", " ", "system", " ",
       "in", " ", "units", " ", "of", " ", "solar", " ", 
      RowBox[{"masses", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"First", ",", " ", 
    RowBox[{
    "define", " ", "a", " ", "Mathematica", " ", "function", " ", "based", " ",
      "on", " ", "Equation", " ", 
     RowBox[{"(", "12.2", ")"}], " ", "from", " ", "the", " ", "\n", 
     "textbook", " ", "to", " ", "easily", " ", "calculate", " ", "the", " ", 
     "final", " ", "frequency", " ", "for", " ", "any", " ", "given", " ", 
     "chirp", " ", 
     RowBox[{"mass", "."}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ffinal", "[", "Mchirp_", "]"}], " ", ":=", " ", 
    RowBox[{"4.0", " ", "/", " ", "Mchirp"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "formula", " ", "for", " ", "the", " ", "chirp", " ", "mass",
       " ", "is", " ", "given", " ", "in", " ", "Chapter", " ", "9"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"Equation", " ", 
       RowBox[{"(", "9.151", ")"}]}], ":"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Mchirp", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m1", "*", "m2"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "5"}], ")"}]}], " ", "/", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m1", "+", "m2"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "5"}], ")"}]}]}], "\n", "where", " ", "m1", " ", 
       "and", " ", "m2", " ", "are", " ", "the", " ", "component", " ", 
       "masses", " ", "of", " ", "the", " ", "binary", " ", "system"}]}], ",",
      " ", 
     RowBox[{"m1", " ", ">=", " ", 
      RowBox[{"m2", " ", "by", " ", "\n", 
       RowBox[{"convention", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Second", ",", " ", 
     RowBox[{
     "define", " ", "a", " ", "Mathematica", " ", "function", " ", "to", " ", 
      "calculate", " ", "the", " ", "chirp", " ", "mass"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"chirpMass", "[", 
     RowBox[{"m1_", ",", " ", "m2_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m1", " ", "*", " ", "m2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "5"}], ")"}]}], " ", "/", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m1", " ", "+", " ", "m2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "5"}], ")"}]}]}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Calculate", " ", "the", " ", "chirp", " ", "mass", " ", "for", " ", 
     "the", " ", "3", " ", "binary", " ", 
     RowBox[{"systems", ":"}]}], " ", "*)"}], "  ", "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"S1", ":", " ", "m1"}], " ", "=", " ", 
     RowBox[{"m2", " ", "=", " ", 
      RowBox[{"10", " ", "solar", " ", "masses"}]}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"mChirpS1", " ", "=", " ", 
    RowBox[{"chirpMass", "[", 
     RowBox[{"10", ",", " ", "10"}], "]"}]}], "\n", 
   RowBox[{"N", "[", "mChirpS1", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9630167618838987`*^9, 3.9630167807130404`*^9}, {
   3.963016820028191*^9, 3.9630168232791233`*^9}, {3.963016854974926*^9, 
   3.96301685851641*^9}, {3.9630175675931892`*^9, 3.963017608456362*^9}, {
   3.963017667301263*^9, 3.963017708945362*^9}, 3.963017750417445*^9, 
   3.96301790122232*^9, {3.963019379757889*^9, 3.96301939879368*^9}, {
   3.963019484151925*^9, 3.9630195124393663`*^9}, {3.9630195523219023`*^9, 
   3.963019602689437*^9}, {3.9630196383912773`*^9, 3.963019798297576*^9}, {
   3.9630199434062347`*^9, 3.963020059887154*^9}, {3.963020189121423*^9, 
   3.963020199327792*^9}, {3.963020444797842*^9, 3.963020459317211*^9}, {
   3.963022458908828*^9, 3.9630224843121643`*^9}, {3.963022579520625*^9, 
   3.963022581191884*^9}, {3.963200048147793*^9, 
   3.9632000773914213`*^9}},ExpressionUUID->"fea938b0-28fa-45d0-8093-\
150e9888ed7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Finally", " ", "frequency", " ", "in", " ", "kHz"}], " ", "*)"}], 
  "\n", 
  RowBox[{"freqS1", " ", "=", " ", 
   RowBox[{"ffinal", "[", "mChirpS1", "]"}]}]}]], "Code",
 CellChangeTimes->{3.963022818413962*^9},
 CellLabel->"In[49]:=",ExpressionUUID->"0b649939-8b63-474b-bec6-db736fb20bcf"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"S2", ":", " ", "m1"}], " ", "=", " ", 
    RowBox[{"m2", " ", "=", " ", 
     RowBox[{
      RowBox[{"10", "^", "6"}], " ", "solar", " ", "masses"}]}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"mChirpS2", " ", "=", " ", 
    RowBox[{"chirpMass", "[", 
     RowBox[{
      RowBox[{"10", "^", "6"}], ",", " ", 
      RowBox[{"10", "^", "6"}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Finally", " ", "frequency", " ", "in", " ", "kHz"}], " ", "*)"}],
    "\n", 
   RowBox[{"freqS2", " ", "=", " ", 
    RowBox[{"ffinal", "[", "mChirpS2", "]"}]}], "\n"}]}]], "Code",
 CellChangeTimes->{{3.963022739105336*^9, 3.963022740797606*^9}, {
  3.9630228170872593`*^9, 3.963022868134768*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"16784c4f-fbf9-4862-ab3f-94285148fc60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"S3", ":", " ", "m1"}], " ", "=", " ", 
    RowBox[{"m2", " ", "=", " ", 
     RowBox[{
      RowBox[{"10", "^", "9"}], " ", "solar", " ", "masses"}]}]}], " ", 
