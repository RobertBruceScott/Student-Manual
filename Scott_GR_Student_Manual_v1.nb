 InterpretationBox[
  RowBox[{"\<\"Pressure p(r) = \"\>", "\[InvisibleSpace]", 
   TagBox[
    FormBox[
     RowBox[{
      RowBox[{"p2", " ", 
       SuperscriptBox["r", "2"]}], "+", 
      RowBox[{"p4", " ", 
       SuperscriptBox["r", "4"]}], "+", "pc"}],
     TraditionalForm],
    TraditionalForm,
    Editable->True]}],
  SequenceForm["Pressure p(r) = ", 
