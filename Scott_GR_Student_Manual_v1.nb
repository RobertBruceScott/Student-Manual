Cell[CellGroupData[{

Cell[TextData[{
 "(c) Quantum gravity is probably important when a photon has enough energy \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]], 
         StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$k_B T$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ee0b573f-4371-4980-a72a-e439341051cd"],
 " to form a black hole within one wavelength ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[Lambda]", "\[LongEqual]", 
           StyleBox["h", "TI"], "/", 
           SubscriptBox[
            StyleBox["k", "TI"], 
            StyleBox["B", "TI"]], 
           StyleBox["T", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$(\\lambda = h/k_B T)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "003a6043-457f-45ae-a068-7353d8948bc4"],
 ". Show that this gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["B", "TI"]], 
         StyleBox["T", "TI"], "\[Tilde]", 
         SuperscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{"1", "/", "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$k_BT \\sim h^{1/2}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f40a2586-0c47-448a-8d93-47ed4878b106"],
 ". This is the Planck temperature. At what time ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$t$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59cb9d8c-ab26-481f-9cc8-c457041c1bcf"],
 " is this an important worry?\n"
}], "Subsubsection",
 CellChangeTimes->{{3.963611028088751*^9, 3.96361108047618*^9}},
 TextJustification->1.,ExpressionUUID->"c44f31f1-1c8f-4f9e-9ec2-50a93dbaabef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"We", " ", "set", " ", "kB", " ", "T"}], " ", "=", " ", 
    RowBox[{"sqrt", 
     RowBox[{"(", 
      RowBox[{"h", " ", 
       RowBox[{
        RowBox[{"c", "^", "5"}], "/", "G"}]}], ")"}], " ", "see", " ", 
     "Scott", " ", 
     RowBox[{"eqn", ".", 
      RowBox[{"(", "13.83", ")"}]}]}]}], "\n", "*)"}], "\n", 
  RowBox[{
   RowBox[{"energyBlackHolePhoton", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"hSI", "*", 
      RowBox[{
       RowBox[{"cSI", "^", "5"}], "/", "GSI"}]}], "]"}]}], "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"energyBlackHolePhoton", ",", "\"\<Joules\>\""}], "]"}], "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"energyBlackHolePhoton", ",", "\"\<eV\>\""}], "]"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "in", " ", "the", " ", "relation", " ", "above", " ", "for", " ", "T", " ",
       "as", " ", "a", " ", "function", " ", "of", " ", "t"}], ",", " ", "\n", 
     RowBox[{"solve", " ", "for", " ", 
      RowBox[{"t", ":"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"t", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"beta", " ", "*", " ", 
       RowBox[{"kBSI", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"hSI", "*", 
          RowBox[{
           RowBox[{"cSI", "^", "5"}], "/", "GSI"}]}], "]"}]}]}], ")"}], "^", 
     "2"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Confirm", " ", "the", " ", "units", " ", "are", " ", "seconds"}],
     " ", "*)"}], " ", "\n", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"t", ",", "\"\<Seconds\>\""}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.963676189536262*^9, 3.96367623129361*^9}, {
  3.963676350466531*^9, 3.9636763537860823`*^9}, {3.963676515231905*^9, 
