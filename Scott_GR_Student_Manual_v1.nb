Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Final", " ", "Frequency", " ", "and", " ", "Wavelength"}], "*)"}],
   "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "now", " ", "calculate", " ", "the", " ", "final", " ", 
    "frequency", " ", 
    RowBox[{"(", "`ffinal`", ")"}], " ", "in", " ", "kHz", " ", "and", " ", 
    "the", " ", "corresponding", " ", "\n", "wavelength", " ", 
    RowBox[{"(", "`lambdafinal`", ")"}], " ", "in", " ", 
    RowBox[{"meters", "."}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
