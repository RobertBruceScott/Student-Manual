 CellLabel->"Out[42]=",ExpressionUUID->"2c87f0cb-5534-4f2e-abb7-298cc25bf982"]
}, Open  ]],

Cell["\<\
To compare the Riemann tensor above with that found in Scott eqn(13.17) we \
could type pull out the desired components various ways:\
\>", "Text",
 CellChangeTimes->{{3.963532043473654*^9, 3.963532159937395*^9}},
 TextJustification->1.,ExpressionUUID->"95b61a69-177a-4540-8e34-fc692e7d10c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifiedAllComponents", " ", "[", 
   RowBox[{"[", 
    RowBox[{"3", ",", "2", ",", "3", ",", "All"}], "]"}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{
  3.96339706005877*^9, {3.9633970997628193`*^9, 3.9633971062131977`*^9}, {
   3.96339716187372*^9, 3.963397164768323*^9}, 3.9634386310519342`*^9, {
   3.9634404256296177`*^9, 3.96344042728253*^9}, {3.963440520509959*^9, 
   3.963440534134577*^9}, {3.963440748930551*^9, 3.9634407716569147`*^9}, {
   3.9634409372721977`*^9, 3.963440938079035*^9}, {3.9634410063565187`*^9, 
   3.963441006969233*^9}, {3.96344228027693*^9, 3.963442283232572*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"2f704dd5-b271-40f2-bc37-8b5b8289505c"],

