   RowBox[{"(*", " ", "Hz", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"timeToSlow", " ", "=", " ", 
     RowBox[{"1000", " ", "*", " ", "secperyear"}]}], ";"}], " ", 
   RowBox[{"(*", " ", "seconds", " ", "*)"}], "\n"}]}]], "Code",
 CellChangeTimes->{{3.9631715064032373`*^9, 3.963171527036882*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"90dffe1e-494a-4ba0-b9b9-5debe9924fa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "rate", " ", "of", " ", "change", " ", "of", " ", "frequency",
      " ", "is", " ", 
     RowBox[{"df", "/", "dt"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"fFinal", " ", "-", " ", "fInitial"}], ")"}], "/", 
     "timeToSlow"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dfdt", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"fFinal", " ", "-", " ", "fInitial"}], ")"}], " ", "/", " ", 
      "timeToSlow"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
