      RowBox[{"v", "^", "4"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"lfTrue", "[", "v", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "We", " ", "can", " ", "understand", " ", "the", " ", "series", " ", 
       "expansion", " ", "above", " ", "by", " ", "compting", " ", "the", " ",
        "\n", "first", " ", "few", " ", "terms", " ", "of", " ", "a", " ", 
       "Taylor", " ", "series", " ", "about", " ", "v"}], "=", 
      RowBox[{"0.", " ", 
       RowBox[{"E", ".", "g", ".", " ", "the"}], " ", 
       RowBox[{"v", "^", "2"}]}]}], ",", " ", 
     RowBox[{"v", "^", "3"}], ",", " ", 
     RowBox[{"and", " ", 
      RowBox[{"v", "^", "4"}]}]}], " ", "\n", " ", "*)"}], "\n", " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "first", " ", "term", " ", "is", " ", "simply", " ", "the", " ",
       "function", " ", "evaluated", " ", "at", " ", "v"}], "=", "0"}], 
    "*)"}], "\n", 
   RowBox[{"term1", " ", "=", " ", 
    RowBox[{"lfTrue", "[", "0", "]"}]}], "\n", 
   RowBox[{"(*", " ", 
