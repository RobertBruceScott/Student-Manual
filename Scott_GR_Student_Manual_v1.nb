Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sub", "-", 
     RowBox[{"part", " ", 
      RowBox[{"(", "vi", ")"}]}]}], ":", " ", 
    RowBox[{"Number", " ", "of", " ", "Independent", " ", "Searches"}]}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "The", " ", "total", " ", "number", " ", "of", " ", "searches", " ", 
      "is", " ", "the", " ", "number", " ", "of", " ", "sky", " ", "patches", 
      " ", "multiplied", " ", "by", " ", "the", " ", "\n", "number", " ", 
      "of", " ", "spin"}], "-", 
     RowBox[{"down", " ", "templates", "  ", "we", " ", "need", " ", "to", " ", 
      RowBox[{"check", ".", " ", "\n", "The"}], " ", "number", " ", "of", " ",
       "spin"}], "-", 
     RowBox[{"down", " ", "templates"}]}], ",", " ", 
    RowBox[{"n", " ", "in", " ", "Scott", " ", "eqn", 
     RowBox[{"(", "12.75", ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "is", " ", "the", " ", "total", " ", "range", " ", "\n", "of", " ", 
      "spin"}], "-", 
     RowBox[{"down", " ", "values", " ", "divided", " ", "by", " ", "the", " ", 
      RowBox[{"resolution", "."}]}]}]}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{"numSpinDownTemplates", " ", "=", " ", 
    RowBox[{"invTauMax", " ", "/", " ", "deltaInvTau"}]}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"compare", " ", "with", " ", "Scott", " ", "eqn", 
