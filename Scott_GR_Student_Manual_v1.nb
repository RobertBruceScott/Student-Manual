    RowBox[{"evaluation", "."}]}], "*)"}], "\n", "\n", 
  RowBox[{"earthOrbitVelocitySI", " ", "=", " ", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"2", "*", "Pi", "*", "auSI"}], "]"}], " ", "/", " ", 
    "secperyear", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"Scott", " ", 
      RowBox[{"eqn", ".", 
       RowBox[{"(", "12.109", ")"}]}]}], " ", "*)"}]}]}]}]], "Code",
